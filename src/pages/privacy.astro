---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — Army Pink" description="How Army Pink collects, uses, and protects your information — compatible with TCPA, VAWA, VOCA, and FVPSA. Special protections for survivors.">

  <div class="legal-layout container">

    <!-- LEFT: STICKY SIDEBAR -->
    <aside class="legal-sidebar" aria-label="Privacy policy sections">
      <nav class="legal-nav">
        <ol>
          <li><a href="#federal-confidentiality" data-section-link>Federal confidentiality</a></li>
          <li><a href="#shelter-protection" data-section-link>Shelter location protection</a></li>
          <li><a href="#what-we-collect" data-section-link>Information we collect</a></li>
          <li><a href="#how-we-use" data-section-link>How we use it</a></li>
          <li><a href="#sms" data-section-link>SMS messages (TCPA)</a></li>
          <li><a href="#who-we-share-with" data-section-link>Who we share with</a></li>
          <li><a href="#cookies" data-section-link>Cookies and analytics</a></li>
          <li><a href="#third-party-links" data-section-link>Third-party links</a></li>
          <li><a href="#your-rights" data-section-link>Your rights</a></li>
          <li><a href="#childrens-privacy" data-section-link>Children's privacy</a></li>
          <li><a href="#related" data-section-link>Related documents</a></li>
          <li><a href="#contact" data-section-link>Contact us</a></li>
        </ol>
      </nav>
    </aside>

    <!-- RIGHT: CONTENT -->
    <article class="legal-content">

      <header class="legal-header">
        <h1>Privacy Policy</h1>
        <p class="legal-updated">
          Last updated: May 22, 2026 &nbsp;·&nbsp; TCPA · VAWA · VOCA · FVPSA compatible
        </p>
        <p class="legal-intro">
          This Privacy Notice describes how Army Pink collects, uses, and protects your
          information. We collect as little as possible, never sell your data, and follow
          the federal confidentiality standards that protect survivors.
        </p>
      </header>

      <!-- SURVIVOR SAFETY CALLOUT -->
      <div class="privacy-callout" id="survivor-safety">
        <div class="privacy-callout-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h2>Survivor safety, first.</h2>
          <p>
            You can browse every free resource on this site without creating an account or
            providing your name. Information you share with us in connection with services
            is protected and will not be disclosed without your informed, written, and
            reasonably time-limited consent, except as described below.
          </p>
          <p>
            If you are concerned about your browsing history, use a private or
            incognito window and <strong>clear your history</strong> when you're done.
            Many browsers also allow you to delete individual site visits.
          </p>
        </div>
      </div>

      <!-- §1 -->
      <section class="privacy-section" id="federal-confidentiality">
        <h2>1. Federal confidentiality protections</h2>
        <p>
          Army Pink is committed to protecting the confidentiality and privacy of all
          persons receiving services, consistent with applicable federal laws, including:
        </p>
        <ul>
          <li>Violence Against Women Act (<strong>VAWA</strong>)</li>
          <li>Victims of Crime Act (<strong>VOCA</strong>)</li>
          <li>Family Violence Prevention and Services Act (<strong>FVPSA</strong>)</li>
        </ul>
        <p>
          Information you share with us in connection with services is protected and will
          not be disclosed without your informed, written, and reasonably time-limited
          consent, except as described in <a href="#who-we-share-with">Section 6</a>.
        </p>
      </section>

      <!-- §2 -->
      <section class="privacy-section" id="shelter-protection">
        <h2>2. Shelter location protection</h2>
        <p>
          The address or location of any confidential shelter facility assisted under this
          program will not be made public without written authorization from the
          individual(s) responsible for operating that facility.
        </p>
      </section>

      <!-- §3 -->
      <section class="privacy-section" id="what-we-collect">
        <h2>3. Information we collect</h2>

        <h3>Information you give us</h3>
        <p>
          We only collect information you actively provide, and only when you choose to
          engage beyond browsing:
        </p>
        <ul>
          <li><strong>Phone number</strong> — collected solely to deliver SMS messages
          directly related to your safe transportation ride and wellness support services.
          See <a href="#sms">Section 5</a> for full SMS terms.</li>
          <li><strong>Email address</strong> — if you subscribe to our newsletter, contact
          us, or sign up for a program.</li>
          <li><strong>Name and email</strong> — if you fill out a volunteer or contact form.</li>
          <li><strong>Donation information</strong> — name, email, and payment details
          processed securely by our fundraising platform, Givebutter. We never store your
          full card number; Givebutter handles payment data under its own privacy policy.</li>
          <li><strong>Discord profile</strong> — name and username if you join our community.
          Governed by Discord's own privacy policy.</li>
        </ul>

        <h3>Information collected automatically</h3>
        <p>When you visit our site, standard web infrastructure may collect:</p>
        <ul>
          <li>Anonymized IP address (used only for general geographic analytics — we cannot
          identify you from this)</li>
          <li>Browser type and device type</li>
          <li>Pages visited and time spent</li>
          <li>Referring URL (how you arrived at the site)</li>
        </ul>

        <h3>What we do not collect</h3>
        <ul>
          <li>Precise GPS or location data</li>
          <li>Phone contacts or call logs</li>
          <li>Health records or clinical information</li>
          <li>Information from children under 13 (see <a href="#childrens-privacy">Section 10</a>)</li>
          <li>Any information beyond what you explicitly provide</li>
        </ul>
      </section>

      <!-- §4 -->
      <section class="privacy-section" id="how-we-use">
        <h2>4. How we use it</h2>
        <p>We use the information we collect only to:</p>
        <ul>
          <li>Coordinate safe transportation rides and wellness support services</li>
          <li>Send SMS messages directly related to your ride or services
          (see <a href="#sms">Section 5</a>)</li>
          <li>Send newsletters, updates, or program communications you requested</li>
          <li>Process and acknowledge donations</li>
          <li>Respond to contact form submissions and volunteer inquiries</li>
          <li>Understand which resources are most helpful (through anonymized analytics)
          so we can improve them</li>
          <li>Report on program outcomes to federal, state, or tribal funders —
          <strong>only in aggregate, non-personally-identifying form</strong>.
          See <a href="#who-we-share-with">Section 6</a>.</li>
        </ul>
        <p>
          We do not use your information for advertising, profiling, or any purpose
          beyond the above list.
        </p>
      </section>

      <!-- §5 -->
      <section class="privacy-section" id="sms">
        <h2>5. SMS messages (TCPA notice)</h2>
        <p>
          Army Pink collects your phone number solely to deliver SMS messages directly
          related to your safe transportation ride and wellness support services.
        </p>

        <h3>Consent and opt-out</h3>
        <ul>
          <li>Providing your phone number and consenting to receive SMS messages is
          <strong>not a condition of eligibility</strong> for Army Pink services.</li>
          <li>You may revoke consent and opt out at any time by texting
          <strong>STOP</strong> to any Army Pink message.</li>
          <li>Opting out will not affect your access to services.</li>
        </ul>

        <h3>Message details</h3>
        <ul>
          <li>Message frequency varies based on your service appointments.</li>
          <li>Message and data rates may apply.</li>
          <li>For support, text <strong>HELP</strong> to any Army Pink message, email
          <a href="mailto:support@armypink.org">support@armypink.org</a>, or call
          <a href="tel:12135795051">(213) 579-5051</a>.</li>
        </ul>

        <h3>SMS provider</h3>
        <p>
          SMS messages are transmitted through our delivery provider, <strong>Twilio,
          Inc.</strong>, which is bound by a data processing agreement limiting its use
          of your information solely to message delivery.
        </p>

        <p>
          For our full SMS Terms of Service, see <a href="/sms-terms">armypink.org/sms-terms</a>.
        </p>
      </section>

      <!-- §6 -->
      <section class="privacy-section" id="who-we-share-with">
        <h2>6. Who we share with — and don't</h2>

        <p>
          Your phone number and any personally identifying information collected in
          connection with our services will not be sold, rented, or disclosed to any
          third party, except:
        </p>

        <h3>Limited, necessary disclosures</h3>
        <ul>
          <li>
            <strong>To transmit SMS messages</strong> — through our delivery provider,
            Twilio, Inc., bound by a data processing agreement limiting use of your
            information solely to message delivery.
          </li>
          <li>
            <strong>To process donations</strong> — through Givebutter, our fundraising
            platform, solely for payment processing.
          </li>
          <li>
            <strong>To deliver newsletters</strong> — through our email platform
            (e.g., Mailchimp or ConvertKit), only to addresses you've explicitly signed up.
            You can unsubscribe at any time.
          </li>
          <li>
            <strong>To community platforms you join</strong> — e.g., Discord, when you
            choose to join our server. Your use of Discord is governed by Discord's
            own Privacy Policy.
          </li>
          <li>
            <strong>As required by law</strong> — including mandatory abuse or neglect
            reporting laws, or a valid court order. In such cases, we will make
            reasonable efforts to notify you and protect your privacy and safety.
          </li>
          <li>
            <strong>In aggregate, non-personally-identifying form</strong> — for program
            reporting, evaluation, or required data collection by federal, state, or
            tribal funders. <strong>Your personally identifying information will never
            be included.</strong>
          </li>
        </ul>

        <h3>We never share with</h3>
        <ul>
          <li>Advertisers or data brokers — ever, under any circumstances</li>
          <li>Abusers, family members, or anyone associated with a survivor's situation</li>
          <li>Other nonprofits or wellness partners without your informed, written, and
          reasonably time-limited consent</li>
        </ul>

        <div class="philosophy-block" style="margin: var(--space-md) 0;">
          <p>"We don't sell healing. We don't sell anything — including your data."</p>
        </div>
      </section>

      <!-- §7 -->
      <section class="privacy-section" id="cookies">
        <h2>7. Cookies and analytics</h2>
        <p>Our site uses a small number of cookies:</p>
        <ul>
          <li>
            <strong>Functional cookies</strong> — required for the site to operate
            correctly (e.g., remembering your donate panel state within a session).
            These are never used for tracking.
          </li>
          <li>
            <strong>Analytics</strong> — we use anonymized, aggregate analytics to
            understand which resources survivors find most useful. IP addresses are
            truncated before storage. No personally identifiable information is used.
          </li>
        </ul>
        <p>
          You can disable cookies in your browser settings at any time. The site
          remains fully usable without analytics cookies.
        </p>
      </section>

      <!-- §8 -->
      <section class="privacy-section" id="third-party-links">
        <h2>8. Third-party links</h2>
        <p>
          Our site links to external services including Do Yoga With Me
          (doyogawithme.com), The National DV Hotline (thehotline.org), Discord, and
          Givebutter. When you follow these links, you leave Army Pink's site and the
          privacy practices of those services apply. We encourage you to review their
          policies:
        </p>
        <ul>
          <li><a href="https://www.doyogawithme.com/privacy_policy" target="_blank" rel="noopener">Do Yoga With Me Privacy Policy</a></li>
          <li><a href="https://www.thehotline.org/privacy-policy/" target="_blank" rel="noopener">The Hotline Privacy Policy</a></li>
          <li><a href="https://discord.com/privacy" target="_blank" rel="noopener">Discord Privacy Policy</a></li>
          <li><a href="https://givebutter.com/privacy" target="_blank" rel="noopener">Givebutter Privacy Policy</a></li>
        </ul>
        <p>
          We only link to services we trust, but we cannot control how those
          organizations handle your data.
        </p>
      </section>

      <!-- §9 -->
      <section class="privacy-section" id="your-rights">
        <h2>9. Your rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li><strong>Opt out of SMS</strong> at any time by texting <strong>STOP</strong>
          to any Army Pink message. Opting out will not affect your access to services.</li>
          <li><strong>Access</strong> — request a copy of any personal information we hold about you</li>
          <li><strong>Correct</strong> — ask us to update inaccurate information</li>
          <li><strong>Delete</strong> — ask us to remove your information from our records</li>
          <li><strong>Opt out of email</strong> — unsubscribe from any newsletter at any
          time using the unsubscribe link in any message we send</li>
          <li><strong>Withdraw consent</strong> — at any time, for any data use beyond
          what is strictly necessary to provide the service you requested</li>
        </ul>
        <p>
          To exercise any of these rights, contact us at
          <a href="mailto:support@armypink.org">support@armypink.org</a>.
          We will respond within 30 days.
        </p>
      </section>

      <!-- §10 -->
      <section class="privacy-section" id="childrens-privacy">
        <h2>10. Children's privacy</h2>
        <p>
          Army Pink's services are not directed to children under the age of 13. We do
          not knowingly collect personal information from children. If you believe a
          child under 13 has provided us with their information, please contact us at
          <a href="mailto:support@armypink.org">support@armypink.org</a> and we will
          delete it promptly.
        </p>
      </section>

      <!-- §11 -->
      <section class="privacy-section" id="related">
        <h2>11. Related documents</h2>
        <p>
          Army Pink's SMS Terms of Service are available at
          <a href="/sms-terms">armypink.org/sms-terms</a>.
        </p>
      </section>

      <!-- §12 -->
      <section class="privacy-section" id="contact">
        <h2>12. Contact us</h2>
        <p>Questions, requests, or concerns about this notice:</p>
        <address class="privacy-contact">
          <strong>Army Pink</strong><br>
          Email: <a href="mailto:support@armypink.org">support@armypink.org</a><br>
          Phone: <a href="tel:12135795051">(213) 579-5051</a>
        </address>
        <p>
          This notice may be updated from time to time. When we make material changes,
          we will update the "last updated" date at the top of this page. Continued use
          of the site after changes constitutes acceptance of the revised notice.
        </p>
      </section>

    </article>
  </div>

  <!-- Sticky sidebar active-section highlight -->
  <script is:inline>
    (function () {
      var links = document.querySelectorAll('[data-section-link]');
      if (!links.length) return;
      var sections = Array.from(links).map(function (a) {
        return document.querySelector(a.getAttribute('href'));
      }).filter(Boolean);

      function setActive(id) {
        links.forEach(function (a) {
          a.classList.toggle('is-active', a.getAttribute('href') === '#' + id);
        });
      }

      var observer = new IntersectionObserver(function (entries) {
        // Pick the entry closest to the top that's intersecting
        var visible = entries
          .filter(function (e) { return e.isIntersecting; })
          .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        if (visible[0]) setActive(visible[0].target.id);
      }, {
        rootMargin: '-100px 0px -60% 0px',
        threshold: 0
      });

      sections.forEach(function (s) { observer.observe(s); });
      // Default: first section active on load
      if (sections[0]) setActive(sections[0].id);
    })();
  </script>

</Layout>
