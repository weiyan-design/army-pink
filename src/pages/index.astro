---
import Layout from '../layouts/Layout.astro';
import { team } from '../data/team.js';

// Non-leadership volunteers with photos — the floating avatars pick a fresh
// random set from these on every page load (client-side, see script.js).
const launchLeadership = ['robin-bement', 'bill-hensley', 'cecelia-machuca', 'debra-prince', 'diana-drews', 'cynthia-modders', 'kathy-hallen', 'liliana-pettenkofer', 'beverly-taridona', 'wei-yan'];
const volunteerPhotos = team.filter((p) => !launchLeadership.includes(p.slug) && p.photo).map((p) => p.photo);

// Stats section — two independent column stacks (right one offset down).
// Reading order pairs across: 1in3/$50, 200/100+, Fall 2026/Survivor-led.
const statsCols = [
  [
    { value: '1 in 3', label: 'women experience intimate partner violence (CDC)' },
    { value: '200', label: 'rides in our first LA pilot' },
    { value: 'Fall 2026', label: 'Freedom Rides launch' },
  ],
  [
    { value: '$50', label: 'funds one ride to safety' },
    { value: '100+', label: 'volunteers building the mission' },
    { value: 'Survivor-led', label: "built by people who've lived it" },
  ],
];

const partners = [
  {
    name: 'Still Mountain Wellness Retreat',
    img: '/img/partner-logo/still-mountain.png',
    href: '#',
    paras: [
      'Spiritual & Holistic Retreats partner dedicated to healing, mindfulness, and transformation.',
      'Together we promote inner peace, empowerment, and renewal for survivors rebuilding their lives.',
    ],
  },
  {
    name: 'Do Yoga With Me',
    img: '/img/partner-logo/do-yoga-with-me.png',
    href: 'https://www.doyogawithme.com',
    paras: [
      'An online yoga and meditation platform offering free and premium classes accessible from anywhere.',
      'Their library curates the Calm Room’s empowering series for survivors at every phase of recovery.',
    ],
  },
  {
    name: 'Charity On Top',
    img: '/img/partner-logo/charity-on-top.png',
    href: '#',
    paras: [
      'A charity gifting platform that lets supporters turn any occasion into impact.',
      'Donations route directly to Army Pink’s Pathway to Freedom program.',
    ],
  },
  {
    name: 'Peace Over Violence',
    img: '/img/partner-logo/peace-over-violence.png',
    href: '#',
    paras: [
      'A Los Angeles nonprofit fighting sexual, domestic, and interpersonal violence since 1971.',
      'A trusted referral partner for survivors seeking advocacy, counseling, and crisis response.',
    ],
  },
  {
    name: 'TheraBox',
    img: '/img/partner-logo/therabox.png',
    href: '#',
    paras: [
      'A therapist-curated subscription box delivering self-care tools and mental wellness practices.',
      'Featured items show up in monthly Escape Club care packages for members.',
    ],
  },
  {
    name: 'The Safe Nest Project',
    img: '/img/partner-logo/safe-nest.jpg',
    href: '#',
    mark: true,
    whiteBg: true,
    paras: [
      'A domestic-violence support partner we work alongside to reach survivors who need a safe way out.',
    ],
  },
];

// Second marquee row — the tools that power Army Pink. Full-color logos,
// contained (not cropped), scrolling the opposite direction.
const techPartners = [
  { name: 'Salesforce', img: '/img/partner-logo/color-salesforce.svg', href: 'https://www.salesforce.com', mark: true, paras: ['Powers our case and donor management, keeping survivor coordination secure and organized.'] },
  { name: 'Slack', img: '/img/partner-logo/color-slack.svg', href: 'https://slack.com', mark: true, paras: ['Where our volunteer team coordinates rides and support in real time.'] },
  { name: 'Google', img: '/img/partner-logo/color-google.svg', href: 'https://www.google.com', mark: true, paras: ['Workspace and cloud tools that run Army Pink day to day.'] },
  { name: 'Microsoft', img: '/img/partner-logo/color-microsoft.svg', href: 'https://www.microsoft.com', mark: true, paras: ['Productivity and cloud tools supporting the team behind the mission.'] },
  { name: 'YouTube', img: '/img/partner-logo/color-youtube.svg', href: 'https://www.youtube.com/@armypink', mark: true, paras: ['Home for our wellness practices and survivor storytelling.'] },
  { name: 'Lyft', img: '/img/partner-logo/color-lyft.png', href: 'https://www.lyft.com', mark: true, paras: ['Our transportation backbone — Freedom Rides dispatch through Lyft Concierge.'] },
  { name: 'Monday.com', img: '/img/partner-logo/color-monday.png', href: 'https://monday.com', mark: true, paras: ['Keeps our projects, campaigns, and launch plans on track.'] },
  { name: 'Canva', img: '/img/partner-logo/color-canva.svg', href: 'https://www.canva.com', mark: true, paras: ['Powers our brand, campaign, and outreach design.'] },
];

// All partners (org + tech) for the greyscale marquee atop the stories section.
const allPartners = [...partners, ...techPartners];

// Programs collage — toggled between Survivors and Supporters. Each set keeps its
// own asymmetric layout (pos = left/top/width/height as % of the 1120×489 frame);
// the two sets overlay and cross-fade. Only the live (featured) card is clickable.
const programs = {
  survivors: [
    { title: 'Wellness Portal', meta: 'Trauma-informed yoga & meditation', img: '/img/program-wellness-portal.jpg', tag: "Coming Fall '26", pos: { l: 0, t: 0, w: 32.74, h: 43.16 } },
    { title: 'Survivor Toolkit', meta: '12 downloadable tools', img: '/img/program-survivor-toolkit.png', tag: "Coming Fall '26", pos: { l: 7.65, t: 45.21, w: 25.09, h: 43.16 } },
    { title: 'Calm Room', meta: 'Guided meditation, calming audio. No login.', img: '/img/program-calm-room.jpg', href: '/wellness-portal', featured: true, pos: { l: 33.63, t: 0, w: 32.74, h: 100 } },
    { title: '30-Day Healing Journey', meta: 'A guided month of gentle practice', img: '/img/program-healing-journey.jpg', tag: "Coming Fall '26", pos: { l: 67.26, t: 11.63, w: 25.09, h: 43.16 } },
    { title: 'Freedom Journal', meta: 'Prompts to reflect, process, and rebuild', img: '/img/program-freedom-journal.jpg', tag: "Coming Fall '26", pos: { l: 67.26, t: 56.84, w: 32.74, h: 43.16 } },
  ],
  supporters: [
    { title: 'Pathway to Freedom', meta: 'Flagship program providing safe transportation', img: '/img/program-pathway.png', tag: "Coming Fall '26", pos: { l: 7.65, t: 0, w: 25.09, h: 43.16 } },
    { title: 'The Escape Club', meta: 'Monthly giving community keeping Freedom Rides available', img: '/img/program-escape-club.png', tag: "Coming Fall '26", pos: { l: 0, t: 45.21, w: 32.74, h: 43.16 } },
    { title: '200 Rides to Freedom', meta: 'Raise $10,000 to fund 200 Freedom Rides', img: '/img/program-200-rides.png', href: '/donate', featured: true, pos: { l: 33.63, t: 0, w: 32.74, h: 100 } },
    { title: 'Freedom Rides', meta: 'Coordinate through partners for safe transportation', img: '/img/program-freedom-rides.png', tag: "Coming Fall '26", pos: { l: 67.26, t: 11.63, w: 32.74, h: 43.16 } },
    { title: 'Campus Impact', meta: 'Student-led events and awareness campaigns', img: '/img/program-campus-impact.jpg', tag: "Coming Fall '26", pos: { l: 67.26, t: 56.84, w: 25.09, h: 43.16 } },
  ],
};
---

<Layout title="Army Pink — Pathway to Freedom">

  <!-- SVG filter: organic torn-paper edges for the survivor-quote note -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="paperTear" x="-12%" y="-12%" width="124%" height="124%">
      <feTurbulence type="fractalNoise" baseFrequency="0.014 0.024" numOctaves="3" seed="7" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="11" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  <!-- ===== HERO: full-bleed sky, mission statement + video card, parallax clouds.
       Sky sits behind the (transparent) nav via a negative-margin underlap. ===== -->
  <section class="sky-hero" id="home" aria-label="Army Pink intro" data-sky-hero data-nav-theme="hero">
    <div class="sky-hero__sky" aria-hidden="true"></div>
    <div class="sky-hero__content">
      <p class="sky-hero__statement">We provide safe, reliable transportation to help survivors escape domestic violence and begin their path to freedom.</p>
      <div class="sky-hero__stage">
        <div class="sky-hero__cloud sky-hero__cloud--left" data-cloud-speed="-0.16" aria-hidden="true">
          <img src="/img/cloud-white.png" alt="" />
        </div>
        <div class="sky-hero__cloud sky-hero__cloud--right" data-cloud-speed="0.1" aria-hidden="true">
          <img src="/img/cloud-warm.png" alt="" />
        </div>
        <button class="sky-hero__video" type="button" data-hero-thumb aria-label="Play the Army Pink intro video">
          <video
            src="/vid/Home_Hero_Vid.mp4"
            autoplay muted loop playsinline preload="auto"
            aria-hidden="true"
          ></video>
          <span class="sky-hero__expand" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- ===== SURVIVOR STORIES (peach section directly beneath the hero) ===== -->
  <section class="section section-stories" id="stories">
    <div class="container">
      <div class="stories-grid">
        <div class="stories-text">
          <span class="pill-label reveal-item">Survivor Stories</span>
          <h2 class="reveal-item">Reflections From<br>Our <em>Community</em></h2>
          <p class="reveal-item">
            Every journey is different. These are the voices of survivors who found
            their way forward - in their own time, on their own terms.
          </p>
          <a href="#" class="btn btn-primary reveal-item">Share your story</a>
        </div>
        <div class="stories-deck-area">
          <div class="stories-deck" id="stories-deck">
            <div class="story-card story-card-active" data-index="0">
              <img src="/img/story-1.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="1">
              <img src="/img/story-2.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="2">
              <img src="/img/story-3.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="3">
              <img src="/img/story-4.png" alt="Survivor portrait" />
            </div>
          </div>
          <div class="story-quote-row">
            <button class="stories-btn stories-prev" aria-label="Previous story">
              <i data-lucide="chevron-left" aria-hidden="true"></i>
            </button>
            <div class="story-quote-box" id="story-quote-box">
              <div class="story-quote story-quote-active" data-index="0">
                <p>"A dream is a wish your heart makes. Army Pink has such an amazing cause
                  helping domestic violence victims such as myself. Every survivor deserves
                  a safe ride."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="1">
                <p>"Army Pink represents something every survivor deserves: hope and a safe
                  path forward. Knowing this support exists means more than words can express."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="2">
                <p>"Army Pink is a lifeline for survivors, showing them they're never alone
                  in their fight for freedom."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="3">
                <p>"Together, we're not just supporting survivors; we're empowering them to
                  reclaim their lives and their futures."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
            </div>
            <button class="stories-btn stories-next" aria-label="Next story">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro video popup (full video with sound) -->
  <div class="video-modal" id="heroVideoModal" role="dialog" aria-modal="true" aria-label="Army Pink intro video" hidden>
    <div class="video-modal__backdrop" data-close></div>
    <div class="video-modal__inner">
      <button class="video-modal__close" type="button" data-close aria-label="Close video">&times;</button>
      <video class="video-modal__vid" src="/vid/Home_Hero_Vid.mp4" controls playsinline preload="none"></video>
    </div>
  </div>

  <!-- ===== PROGRAMS — "We're here for every step" (Survivors / Supporters toggle) ===== -->
  <section class="programs" id="support" aria-label="Our programs">
    <div class="container">
      <div class="programs__head">
        <span class="programs__eyebrow">Current &amp; Upcoming Programs</span>
        <h2 class="programs__title">We're here for <em>every step</em></h2>
        <div class="programs__toggle" role="tablist" aria-label="Choose audience" data-programs-toggle>
          <button class="programs__tab is-active" type="button" role="tab" aria-selected="true" data-prog="survivors">Survivors</button>
          <button class="programs__tab" type="button" role="tab" aria-selected="false" data-prog="supporters">Supporters</button>
          <span class="programs__tab-ind" aria-hidden="true"></span>
        </div>
      </div>
      <div class="programs__stage" data-programs-stage>
        {Object.entries(programs).map(([group, cards]) => (
          <div class="programs__set" data-prog={group} aria-hidden={group === 'survivors' ? 'false' : 'true'}>
            {cards.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              return (
                <Tag
                  class={`program-card${c.featured ? ' program-card--featured' : ''}`}
                  href={c.href || undefined}
                  style={`left:${c.pos.l}%;top:${c.pos.t}%;width:${c.pos.w}%;height:${c.pos.h}%`}
                >
                  <img class="program-card__img" src={c.img} alt={c.title} loading="lazy" />
                  {c.tag && <span class="program-card__tag">{c.tag}</span>}
                  <div class="program-card__body">
                    <h3 class="program-card__title">{c.title}</h3>
                    <p class="program-card__meta">{c.meta}</p>
                  </div>
                </Tag>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HELP LAUNCH THE MOVEMENT — volunteer callout + donate form ===== -->
  <section class="launch launch--volunteers" id="launch" aria-label="Help launch the movement" data-launch data-volunteer-photos={JSON.stringify(volunteerPhotos)}>
    <div class="launch__callout">
      <div class="launch__avatars" aria-hidden="true">
        <span class="launch__avatar launch__avatar--1" data-depth="22"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--2" data-depth="14"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--3" data-depth="26"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--4" data-depth="20"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--5" data-depth="14"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--6" data-depth="24"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
      </div>
      <div class="launch__intro">
        <h2 class="launch__title">Help launch <em>the movement</em></h2>
        <p class="launch__lead">From tech to design to outreach, everyday people give their skills to help survivors reach safety. Find your place on the team.</p>
        <div class="launch__cta">
          <button class="btn btn-primary" type="button" data-volunteer-form>Become A Volunteer</button>
        </div>
        <a class="launch__joined" href="/volunteers">
          <span class="launch__joined-avatars" aria-hidden="true">
            <span class="launch__joined-av"></span>
            <span class="launch__joined-av"></span>
            <span class="launch__joined-av"></span>
          </span>
          <span class="launch__joined-text"><strong>100+ volunteers</strong> already joined the movement</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== DONATE — sun + landscape + Givebutter form ===== -->
  <section class="launch launch--donate" aria-label="Support survivors" data-launch>
    <div class="launch__form-wrap">
      <img class="launch__sun" src="/img/sun.png" alt="" aria-hidden="true" />
      <img class="launch__car" src="/img/freedom-rides-car.gif" alt="" aria-hidden="true" data-launch-car />
      <img class="launch__love" src="/img/love.svg" alt="" aria-hidden="true" data-launch-love />
      <div class="launch__form">
        <div class="launch__form-photo">
          <img src="/img/donate-form-img.jpg" alt="A survivor leaping freely through a sunlit field" loading="lazy" />
        </div>
        <div class="launch__form-widget">
          <givebutter-widget id="jb2b4P"></givebutter-widget>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ESCAPE CLUB TEASER ===== -->
  <section class="feature-carousel feature-carousel--cream" data-feature-carousel>
    <svg class="fc-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,36 C360,0 720,76 1080,36 C1260,16 1380,46 1440,36 L1440,80 L0,80 Z"/>
    </svg>
    <div class="container">
      <div class="fc-header">
        <h2>Healing is harder alone.</h2>
        <a href="/donate" class="btn btn-ghost">Join the community</a>
      </div>
      <div class="fc-track">
        <article class="fc-card is-active" data-caption="A community of survivors who've walked your path — meeting you in the in-between.">
          <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
        </article>
        <article class="fc-card" data-caption="Weekly check-ins, kept small enough to feel personal.">
          <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
        </article>
        <article class="fc-card" data-caption="Mentors who remember what year one felt like.">
          <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
        </article>
        <article class="fc-card" data-caption="Cohorts that move at your pace — no one is left behind.">
          <img src="https://images.unsplash.com/photo-1543269865-cbf427effbad?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
        </article>
        <article class="fc-card" data-caption="Peer support designed for the long stretch after the escape.">
          <img src="https://images.unsplash.com/photo-1502635385003-ee1e6a1a742d?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
        </article>
      </div>
      <div class="fc-footer">
        <p class="fc-caption">A community of survivors who've walked your path — meeting you in the in-between.</p>
        <div class="fc-controls">
          <button class="fc-arrow fc-arrow--prev" aria-label="Previous">&lsaquo;</button>
          <button class="fc-arrow fc-arrow--next" aria-label="Next">&rsaquo;</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTNERS ===== -->
  <section class="partner-section">
    <div class="partner-header">
      <span class="pill-label">Army Pink is empowered by</span>
    </div>
    <div class="partner-track-wrap">
      <div class="partner-track" data-partner-track>
        {[0, 1].map((setIdx) => partners.map((p) => (
          <article class={`partner-tile${p.mark ? ' partner-tile--logo' : ''}${p.whiteBg ? ' partner-tile--multiply' : ''}`} data-partner aria-hidden={setIdx === 1 ? 'true' : undefined}>
            <div class="partner-tile-inner">
              <div class="partner-face partner-face--front">
                <div class="partner-photo">
                  <img src={p.img} alt="" loading="lazy" />
                </div>
                <h3 class="partner-name">{p.name}</h3>
              </div>
              <div class="partner-face partner-face--back">
                <h3 class="partner-back-name">{p.name}</h3>
                <div class="partner-back-body">
                  {p.paras.map((para) => <p>{para}</p>)}
                </div>
                <a href={p.href} class="partner-link" target={p.href.startsWith('http') ? '_blank' : undefined} rel={p.href.startsWith('http') ? 'noopener' : undefined}>Visit Them</a>
              </div>
            </div>
          </article>
        )))}
      </div>
    </div>

    <!-- Row 2: tools that power Army Pink — static greyscale logos, reverse scroll -->
    <div class="partner-track-wrap">
      <div class="partner-track partner-track--reverse" data-partner-track>
        {[0, 1].map((setIdx) => techPartners.map((p) => (
          <a
            class="partner-tile partner-tile--static"
            href={p.href}
            target={p.href.startsWith('http') ? '_blank' : undefined}
            rel={p.href.startsWith('http') ? 'noopener' : undefined}
            aria-label={p.name}
            aria-hidden={setIdx === 1 ? 'true' : undefined}
            tabindex={setIdx === 1 ? '-1' : undefined}
          >
            <div class="partner-photo">
              <img src={p.img} alt={p.name} loading="lazy" />
            </div>
          </a>
        )))}
      </div>
    </div>

    <div class="partner-footer">
      <a href="/partners" class="btn btn-ghost">Become A Partner</a>
    </div>
  </section>

  <!-- ===== ABOUT ARMY PINK ===== -->
  <section class="section section-mission" id="mission">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-text">
          <span class="overline">Our Mission</span>
          <h2>We don't provide rides.<br>We provide access to safety.<br><br>We don't sell healing.<br>We connect you to it.</h2>
          <p>
            Army Pink is a 501(c)(3) nonprofit supporting domestic violence survivors
            through safety-centered transportation, concierge support, and wellness resources.
          </p>
          <p>
            Our <strong>Pathway to Freedom</strong> program provides donation-based Freedom Rides —
            immediate safe transportation when you need it most — plus connections to
            ongoing wellness support for the road ahead.
          </p>
          <p class="quiet">Based in California. Serving survivors nationwide.</p>
        </div>
        <div class="mission-values">
          <div class="value">
            <span class="value-number">01</span>
            <div>
              <h4>Safety First</h4>
              <p>Every decision we make starts with your safety.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">02</span>
            <div>
              <h4>Survivor-Led</h4>
              <p>People who understand the journey shape our work.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">03</span>
            <div>
              <h4>No Barriers</h4>
              <p>Survivors never pay. Supporters make that possible.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE / STATS (moved to bottom for now) ===== -->
  <section class="stats-section" aria-label="Army Pink at a glance">
