---
import Layout from '../layouts/Layout.astro';
import { team } from '../data/team.js';

// Non-leadership volunteers with photos — the floating avatars pick a fresh
// random set from these on every page load (client-side, see script.js).
const launchLeadership = ['robin-bement', 'bill-hensley', 'cecelia-machuca', 'debra-prince', 'diana-drews', 'cynthia-modders', 'kathy-hallen', 'liliana-pettenkofer', 'beverly-taridona', 'wei-yan'];
const volunteerPhotos = team.filter((p) => !launchLeadership.includes(p.slug) && p.photo).map((p) => p.photo);

const partners = [
  {
    name: 'Still Mountain Wellness Retreat',
    img: '/img/partner-logo/still-mountain.png',
    href: '#',
    paras: [
      'Spiritual & Holistic Retreats partner dedicated to healing, mindfulness, and transformation.',
      'Together we promote inner peace, empowerment, and renewal for survivors rebuilding their lives.',
    ],
  },
  {
    name: 'Do Yoga With Me',
    img: '/img/partner-logo/do-yoga-with-me.png',
    href: 'https://www.doyogawithme.com',
    paras: [
      'An online yoga and meditation platform offering free and premium classes accessible from anywhere.',
      'Their library curates the Calm Room’s empowering series for survivors at every phase of recovery.',
    ],
  },
  {
    name: 'Charity On Top',
    img: '/img/partner-logo/charity-on-top.png',
    href: '#',
    paras: [
      'A charity gifting platform that lets supporters turn any occasion into impact.',
      'Donations route directly to Army Pink’s Pathway to Freedom program.',
    ],
  },
  {
    name: 'Peace Over Violence',
    img: '/img/partner-logo/peace-over-violence.png',
    href: '#',
    paras: [
      'A Los Angeles nonprofit fighting sexual, domestic, and interpersonal violence since 1971.',
      'A trusted referral partner for survivors seeking advocacy, counseling, and crisis response.',
    ],
  },
  {
    name: 'TheraBox',
    img: '/img/partner-logo/therabox.png',
    href: '#',
    paras: [
      'A therapist-curated subscription box delivering self-care tools and mental wellness practices.',
      'Featured items show up in monthly Escape Club care packages for members.',
    ],
  },
  {
    name: 'The Safe Nest Project',
    img: '/img/partner-logo/safe-nest.jpg',
    href: '#',
    mark: true,
    whiteBg: true,
    paras: [
      'A domestic-violence support partner we work alongside to reach survivors who need a safe way out.',
    ],
  },
];

// Second marquee row — the tools that power Army Pink. Full-color logos,
// contained (not cropped), scrolling the opposite direction.
const techPartners = [
  { name: 'Salesforce', img: '/img/partner-logo/color-salesforce.svg', href: 'https://www.salesforce.com', mark: true, paras: ['Powers our case and donor management, keeping survivor coordination secure and organized.'] },
  { name: 'Slack', img: '/img/partner-logo/color-slack.svg', href: 'https://slack.com', mark: true, paras: ['Where our volunteer team coordinates rides and support in real time.'] },
  { name: 'Google', img: '/img/partner-logo/color-google.svg', href: 'https://www.google.com', mark: true, paras: ['Workspace and cloud tools that run Army Pink day to day.'] },
  { name: 'Microsoft', img: '/img/partner-logo/color-microsoft.svg', href: 'https://www.microsoft.com', mark: true, paras: ['Productivity and cloud tools supporting the team behind the mission.'] },
  { name: 'YouTube', img: '/img/partner-logo/color-youtube.svg', href: 'https://www.youtube.com/@armypink', mark: true, paras: ['Home for our wellness practices and survivor storytelling.'] },
  { name: 'Lyft', img: '/img/partner-logo/color-lyft.png', href: 'https://www.lyft.com', mark: true, paras: ['Our transportation backbone — Freedom Rides dispatch through Lyft Concierge.'] },
  { name: 'Monday.com', img: '/img/partner-logo/color-monday.png', href: 'https://monday.com', mark: true, paras: ['Keeps our projects, campaigns, and launch plans on track.'] },
  { name: 'Canva', img: '/img/partner-logo/color-canva.svg', href: 'https://www.canva.com', mark: true, paras: ['Powers our brand, campaign, and outreach design.'] },
];

// All partners (org + tech) for the greyscale marquee atop the stories section.
const allPartners = [...partners, ...techPartners];

// Programs for Survivors — the four "in the making" programs shown as a coverflow
// (one expanded card + slivers, reusing the .fc-* feature-carousel). No labels on
// the cards themselves; the description + "Help Us Build" CTA live underneath and
// swap with whichever card is active.
// Each caption = the program name (semibold) + the rest of the sentence; the two
// are kept separate so the name can be bolded both in the markup and when the JS
// swaps the live caption on card change.
const survivorPrograms = [
  { img: '/img/program-wellness-portal.jpg',  name: 'Wellness Portal',           rest: 'offers grounding tools and wellness resources for survivors.' },
  { img: '/img/program-survivor-toolkit.png', name: 'The Survivor Toolkit',       rest: 'is the practical stuff — safety planning, a safe-exit roadmap, and guides for starting over: housing, money, the next hard phone call.' },
  { img: '/img/program-healing-journey.jpg',  name: 'The 30-Day Healing Journey', rest: 'gives you something small to hold onto each day — a prompt, a grounding practice, one step forward.' },
  { img: '/img/program-freedom-journal.jpg',  name: 'The Freedom Journal',         rest: "is a place to process — guided prompts to make sense of what happened, and who you're becoming." },
];
const progCaption = (p) => `<strong class="psg__prog">${p.name}</strong> ${p.rest}`;

// 200 Rides to Freedom — home teaser (mirrors the /donate figures).
const waysRides = 102;
const waysGoal = 200;
const waysTicks = 40;
const waysFilled = Math.round((waysRides / waysGoal) * waysTicks);
const waysPct = (waysRides / waysGoal) * 100;

// "Other Ways to Give" rows. icon = a stand-in from /img (real Escape-Club /
// steering-wheel / ticket / college marks to be swapped in). action: 'donate'
// opens the Givebutter popup; 'contact' opens the contact slide-up form.
const waysToGive = [
  { cat: 'Membership',       title: 'Escape Club',          desc: 'A community of monthly supporters keeping Freedom Rides on the road all year.', icon: '/img/give-escape-club.png',    cta: 'Join',       action: 'donate'  },
  { cat: 'In-kind & Service', title: 'Partnership',          desc: 'Companies fund rides or sponsor the mission.',                                  icon: '/img/give-partnership.png',    cta: 'Contact Us', action: 'contact' },
  { cat: 'Events',           title: 'Golden Ticket Auction', desc: 'Buy tickets / bid at the benefit event.',                                       icon: '/img/give-golden-ticket.png',  cta: 'Contact Us', action: 'contact' },
  { cat: 'Events',           title: 'Campus Impact',         desc: 'Campus chapters & student-led events.',                                         icon: '/img/give-campus-impact.png',  cta: 'Contact Us', action: 'contact' },
];
---

<Layout title="Army Pink — Pathway to Freedom">

  <!-- SVG filter: organic torn-paper edges for the survivor-quote note -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="paperTear" x="-12%" y="-12%" width="124%" height="124%">
      <feTurbulence type="fractalNoise" baseFrequency="0.014 0.024" numOctaves="3" seed="7" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="11" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>

  <!-- ===== HERO: full-bleed sky, mission statement + video card, parallax clouds.
       Sky sits behind the (transparent) nav via a negative-margin underlap. ===== -->
  <section class="sky-hero" id="home" aria-label="Army Pink intro" data-sky-hero data-nav-theme="hero">
    <div class="sky-hero__sky" aria-hidden="true"></div>
    <div class="sky-hero__content">
      <p class="sky-hero__statement">We provide safe, reliable transportation to help survivors escape domestic violence and begin their path to freedom.</p>
      <div class="sky-hero__stage">
        <div class="sky-hero__cloud sky-hero__cloud--left" data-cloud-speed="-0.16" aria-hidden="true">
          <img src="/img/cloud-white.png" alt="" />
        </div>
        <div class="sky-hero__cloud sky-hero__cloud--right" data-cloud-speed="0.1" aria-hidden="true">
          <img src="/img/cloud-warm.png" alt="" />
        </div>
        <button class="sky-hero__video" type="button" data-hero-thumb aria-label="Play the Army Pink intro video">
          <video
            src="/vid/Home_Hero_Vid.mp4"
            autoplay muted loop playsinline preload="auto"
            aria-hidden="true"
          ></video>
          <span class="sky-hero__expand" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- ===== SURVIVOR STORIES (peach section directly beneath the hero) ===== -->
  <section class="section section-stories" id="stories">
    <div class="container">
      <div class="stories-grid">
        <div class="stories-text">
          <span class="pill-label reveal-item">Survivor Stories</span>
          <h2 class="section-title reveal-item">Reflections From<br>Our <em>Community</em></h2>
          <p class="section-text reveal-item">
            Every journey is different. These are the voices of survivors who found
            their way forward - in their own time, on their own terms.
          </p>
          <a href="#" class="btn btn-primary reveal-item">Share your story</a>
        </div>
        <div class="stories-deck-area">
          <div class="stories-deck" id="stories-deck">
            <div class="story-card story-card-active" data-index="0">
              <img src="/img/story-1.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="1">
              <img src="/img/story-2.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="2">
              <img src="/img/story-3.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="3">
              <img src="/img/story-4.png" alt="Survivor portrait" />
            </div>
          </div>
          <div class="story-quote-row">
            <button class="stories-btn stories-prev" aria-label="Previous story">
              <i data-lucide="chevron-left" aria-hidden="true"></i>
            </button>
            <div class="story-quote-box" id="story-quote-box">
              <div class="story-quote story-quote-active" data-index="0">
                <p>"A dream is a wish your heart makes. Army Pink has such an amazing cause
                  helping domestic violence victims such as myself. Every survivor deserves
                  a safe ride."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="1">
                <p>"Army Pink represents something every survivor deserves: hope and a safe
                  path forward. Knowing this support exists means more than words can express."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="2">
                <p>"Army Pink is a lifeline for survivors, showing them they're never alone
                  in their fight for freedom."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
              <div class="story-quote" data-index="3">
                <p>"Together, we're not just supporting survivors; we're empowering them to
                  reclaim their lives and their futures."</p>
                <div class="story-author">
                  <strong>Anonymous Survivor</strong>
                </div>
              </div>
            </div>
            <button class="stories-btn stories-next" aria-label="Next story">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro video popup (full video with sound) -->
  <div class="video-modal" id="heroVideoModal" role="dialog" aria-modal="true" aria-label="Army Pink intro video" hidden>
    <div class="video-modal__backdrop" data-close></div>
    <div class="video-modal__inner">
      <button class="video-modal__close" type="button" data-close aria-label="Close video">&times;</button>
      <video class="video-modal__vid" src="/vid/Home_Hero_Vid.mp4" controls playsinline preload="none"></video>
    </div>
  </div>

  <!-- ===== PROGRAMS FOR SURVIVORS — pinned arch beside a scrolling column,
       with the "in the making" coverflow (reuses .fc-* feature-carousel JS) ===== -->
  <section class="psg" id="support" aria-label="Programs for survivors">
    <!-- Cream band: just the title, aligned to the right content column -->
    <div class="psg__band psg__band--cream">
      <div class="container psg__grid">
        <div class="psg__media" aria-hidden="true"></div>
        <header class="psg__head">
          <span class="pill-label reveal-item">Programs for Survivors</span>
          <h2 class="section-title section-title--lg reveal-item">We're here for <br><em>every step</em></h2>
        </header>
      </div>
    </div>

    <!-- Yellow band (full-width): pinned arch (left) + scrolling content (right).
         The arch floats up into the cream band above and its sticky container ends
         at the caption, so its foot lands on the description at the bottom. -->
    <div class="psg__band psg__band--yellow">
      <div class="container psg__grid">
        <div class="psg__media">
          <div class="empowering-image psg__arch">
            <video src="/vid/calm-room-cover.mp4" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
            <div class="psg__glass">
              <span class="psg__glass-label">Calm Room</span>
              <a class="psg__glass-btn" href="/wellness-portal">Explore</a>
            </div>
          </div>
        </div>

        <div class="psg__content">
          <div class="psg__intro">
            <p class="section-text reveal-item">Getting out is the first step. What comes next is often harder — the panic that hits at 2am, the nights you can't sleep, figuring out who you are again once the dust settles. The programs we're building are for this part. We aim to give you a private, safe place to land, for free.</p>
            <p class="section-text reveal-item">None of this replaces a therapist or a crisis line. It's the support in between — for the ordinary, brutal work of rebuilding a life. You don't have to do it alone.</p>
          </div>

          <!-- "Programs In The Making" — coverflow (one expanded card + slivers) -->
          <div class="psg__making" data-feature-carousel>
            <div class="psg__making-head">
              <h3 class="psg__making-title">Programs In The Making</h3>
              <div class="fc-controls">
                <button class="fc-arrow fc-arrow--prev" aria-label="Previous program">&lsaquo;</button>
                <button class="fc-arrow fc-arrow--next" aria-label="Next program">&rsaquo;</button>
              </div>
            </div>

            <div class="fc-track psg__track">
              {survivorPrograms.map((p, i) => (
                <article
                  class={`fc-card${i === 0 ? ' is-active' : ''}`}
                  data-caption={progCaption(p)}
                  data-cta-href="/get-involved"
                  data-cta-label="Help Us Build"
                >
                  <img src={p.img} alt="" loading="lazy" />
                </article>
              ))}
            </div>

            <div class="psg__footer">
              <p class="fc-caption" set:html={progCaption(survivorPrograms[0])}></p>
              <a class="btn btn-secondary" href="/get-involved">Help Us Build</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 200 RIDES TO FREEDOM — fundraising teaser. Mirror of the section above
       (content left, pinned media right). Reuses the cream/yellow bands, global text
       components, and the /donate impact video + tracker. A car drives along the
       tracker as you scroll the section. ===== -->
  <section class="ways" id="ways" aria-label="200 Rides to Freedom" data-ways style={`--car-max:${waysPct.toFixed(2)}`}>
    <!-- Cream band: eyebrow + title (left) -->
    <div class="ways__band ways__band--cream">
      <div class="container ways__grid">
        <div class="ways__intro">
          <header class="ways__head">
            <span class="pill-label reveal-item">Current Fundraising Campaign</span>
            <h2 class="section-title section-title--lg reveal-item">200 Rides to <em>Freedom</em></h2>
          </header>
        </div>
        <div class="ways__media" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Body band (light grey): body + "Other Ways to Give" (left); pinned impact card + tracker (right) -->
    <div class="ways__band ways__band--body">
      <div class="container ways__grid">
        <div class="ways__content">
          <!-- Stacked (mobile) title — renders under the video + Fund button; the
               cream-band title above is hidden at this breakpoint. -->
          <header class="ways__head ways__head--stacked reveal-item">
            <span class="pill-label">Current Fundraising Campaign</span>
            <h2 class="section-title section-title--lg">200 Rides to <em>Freedom</em></h2>
          </header>
          <!-- tracker + car moved here, directly above the description -->
          <div
            class="dn-tracker ways__tracker"
            data-tracker
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax={waysGoal}
            aria-valuenow={waysRides}
            aria-label={`${waysRides} of ${waysGoal} rides funded`}
          >
            <div class="dn-tracker__bar">
              <div class="dn-tracker__bubble">
                <span class="dn-tracker__count">{waysRides}</span>
                <span class="dn-tracker__label">Rides Funded</span>
              </div>
              {Array.from({ length: waysTicks }).map((_, i) => (
                <span class={`dn-tracker__tick${i < waysFilled ? ' is-filled' : ''}`}></span>
              ))}
              <img class="ways__car" src="/img/freedom-rides-car.gif" alt="" aria-hidden="true" data-ways-car />
            </div>
          </div>

          <p class="section-text reveal-item">Every gift helps provide safe, discreet transportation for survivors who need to leave unsafe environments, reach safe destinations, or access critical services. <span class="ways__cost">A single Freedom Ride costs $50</span> and can help a survivor reach shelter, medical care, legal support, a trusted support network, or another destination connected to their safety plan. A ride at the right time can save a life.</p>

          <h3 class="ways__sub reveal-item">Other Ways to Give</h3>
          <ul class="give-list">
            {waysToGive.map((w) => (
              <li class="give-row reveal-item">
                <img class="give-row__icon" src={w.icon} alt="" loading="lazy" />
                <span class="give-row__cat">{w.cat}</span>
                <h4 class="give-row__title">{w.title}</h4>
                <div class="give-row__foot">
                  <p class="give-row__desc">{w.desc}</p>
                  <button
                    class="give-row__cta"
                    type="button"
                    data-donate-panel={w.action === 'donate' ? true : undefined}
                    data-contact-form={w.action === 'contact' ? true : undefined}
                  >{w.cta}</button>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="ways__media">
          <div class="ways__pin">
            <div class="ways__card">
              <video class="ways__vid" src="/vid/give-impact-loop.mp4" autoplay muted loop playsinline preload="auto" aria-label="Army Pink Freedom Rides impact loop"></video>
            </div>
            <div class="ways__actions">
              <button class="btn btn-primary" type="button">Fund 200 Rides</button>
              <a class="btn btn-secondary" href="https://givebutter.com/c/200-rides-x4a9e7" target="_blank" rel="noopener">Learn more</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTNERS — moved up to follow the 200 Rides section ===== -->
  <section class="partner-section">
    <div class="partner-header">
      <span class="pill-label">Army Pink is empowered by</span>
    </div>
    <div class="partner-track-wrap">
      <div class="partner-track" data-partner-track>
        {[0, 1].map((setIdx) => partners.map((p) => (
          <article class={`partner-tile${p.mark ? ' partner-tile--logo' : ''}${p.whiteBg ? ' partner-tile--multiply' : ''}`} data-partner aria-hidden={setIdx === 1 ? 'true' : undefined}>
            <div class="partner-tile-inner">
              <div class="partner-face partner-face--front">
                <div class="partner-photo">
                  <img src={p.img} alt="" loading="lazy" />
                </div>
                <h3 class="partner-name">{p.name}</h3>
              </div>
              <div class="partner-face partner-face--back">
                <h3 class="partner-back-name">{p.name}</h3>
                <div class="partner-back-body">
                  {p.paras.map((para) => <p>{para}</p>)}
                </div>
                <a href={p.href} class="partner-link" target={p.href.startsWith('http') ? '_blank' : undefined} rel={p.href.startsWith('http') ? 'noopener' : undefined}>Visit Them</a>
              </div>
            </div>
          </article>
        )))}
      </div>
    </div>

    <!-- Row 2: tools that power Army Pink — static greyscale logos, reverse scroll -->
    <div class="partner-track-wrap">
      <div class="partner-track partner-track--reverse" data-partner-track>
        {[0, 1].map((setIdx) => techPartners.map((p) => (
          <a
            class="partner-tile partner-tile--static"
            href={p.href}
            target={p.href.startsWith('http') ? '_blank' : undefined}
            rel={p.href.startsWith('http') ? 'noopener' : undefined}
            aria-label={p.name}
            aria-hidden={setIdx === 1 ? 'true' : undefined}
            tabindex={setIdx === 1 ? '-1' : undefined}
          >
            <div class="partner-photo">
              <img src={p.img} alt={p.name} loading="lazy" />
            </div>
          </a>
        )))}
      </div>
    </div>

    <div class="partner-footer">
      <a href="#" class="btn btn-secondary" data-contact-form>Become A Partner</a>
    </div>
  </section>

  <!-- ===== HELP LAUNCH THE MOVEMENT — volunteer callout + donate form ===== -->
  <section class="launch launch--volunteers" id="launch" aria-label="Help launch the movement" data-launch data-volunteer-photos={JSON.stringify(volunteerPhotos)}>
    <div class="launch__callout">
      <div class="launch__avatars" aria-hidden="true">
        <span class="launch__avatar launch__avatar--1 launch__avatar--blob" data-depth="22"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--2 launch__avatar--blob" data-depth="14"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--3 launch__avatar--blob" data-depth="26"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--4 launch__avatar--blob" data-depth="20"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--5 launch__avatar--blob" data-depth="14"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
        <span class="launch__avatar launch__avatar--6 launch__avatar--blob" data-depth="24"><img class="launch__avatar-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /></span>
      </div>
      <div class="launch__intro">
        <h2 class="section-title">Our volunteers make<br><em>freedom possible.</em></h2>
        <p class="section-text">From tech to design to outreach, everyday people give their skills to help survivors reach safety. Find your place on the team.</p>
        <div class="launch__cta">
          <button class="btn btn-primary" type="button" data-volunteer-form>Become A Volunteer</button>
        </div>
        <a class="launch__joined" href="/volunteers">
          <span class="launch__joined-avatars" aria-hidden="true">
            <span class="launch__joined-av"></span>
            <span class="launch__joined-av"></span>
            <span class="launch__joined-av"></span>
          </span>
          <span class="launch__joined-text"><strong>100+ volunteers</strong> already joined the movement</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== DONATE — cloud meadow + flower + Givebutter form ===== -->
  <section class="launch launch--donate" aria-label="Support survivors" data-launch>
