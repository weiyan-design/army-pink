---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — Army Pink" description="Get in touch with Army Pink. For general inquiries, volunteering, partnership, or press — we respond within a few business days.">

  <!-- CONTACT -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <!-- LEFT: INFO METHODS -->
        <aside class="contact-aside reveal-item">

          <div class="contact-method">
            <div class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="contact-method-body">
              <h3>Email</h3>
              <p>The fastest way to reach us.</p>
              <p><a href="mailto:support@armypink.org">support@armypink.org</a></p>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            </div>
            <div class="contact-method-body">
              <h3>Community</h3>
              <p>Peer support, weekly check-ins, and wellness sessions on Discord.</p>
              <p><a href="/escape-club">Visit the Escape Club →</a></p>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="contact-method-body">
              <h3>Response time</h3>
              <p>We aim to reply to every message within 2–3 business days.</p>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="contact-method-body">
              <h3>For partners</h3>
              <p>Interested in collaboration? Read about our <a href="/partners">partnership models</a> first.</p>
            </div>
          </div>

          <!-- SOCIALS AT BOTTOM -->
          <div class="contact-aside-socials" aria-label="Social media">
            <a href="https://www.instagram.com/armypink" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/army-pink/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.youtube.com/@armypink" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.pinterest.com/armypink/" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
          </div>
        </aside>

        <!-- RIGHT: YELLOW CARD WITH FORM -->
        <div class="contact-form-wrap reveal-item">

          <div class="contact-card">
            <h1>Let's start a conversation.</h1>
            <p class="contact-form-intro">
              Whether you're here to volunteer, partner, ask a question, or simply say hello, we'd love to hear from you.
            </p>

            <form
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/contact?sent=true"
              class="contact-form"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="contact-honeypot" hidden>
                <label>Don't fill this out: <input name="bot-field" /></label>
              </p>

              <div class="contact-field">
                <label for="contact-reason">Reason for contact</label>
                <select id="contact-reason" name="reason" required>
                  <option value="general">General inquiry</option>
                  <option value="volunteer">Volunteer</option>
                  <option value="partnership">Partnership</option>
                  <option value="press">Press / media</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="contact-field">
                <label for="contact-name">Your name <span class="contact-optional">(optional)</span></label>
                <input id="contact-name" name="name" type="text" autocomplete="name" />
              </div>

              <div class="contact-field">
                <label for="contact-email">Email <span class="contact-required" aria-hidden="true">*</span></label>
                <input id="contact-email" name="email" type="email" required autocomplete="email" />
              </div>

              <div class="contact-field">
                <label for="contact-message">Message <span class="contact-required" aria-hidden="true">*</span></label>
                <textarea id="contact-message" name="message" rows="6" required placeholder="Tell us what's on your mind. Take your time."></textarea>
              </div>

              <div class="contact-actions">
                <button type="submit" class="btn btn-primary contact-submit">Send message</button>
                <p class="contact-privacy-note">
                  Your message goes only to our team. See our <a href="/privacy">Privacy Policy</a>.
                </p>
              </div>
            </form>
          </div>

          <!-- Success message (shown when ?sent=true) -->
          <div class="contact-success" id="contact-success" hidden>
            <div class="contact-success-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Thank you — your message is on its way.</h3>
            <p>We'll be in touch as soon as we can. In the meantime, you might enjoy our <a href="/wellness-portal">Wellness Portal</a>.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2 class="reveal-item">Not ready to write yet?</h2>
      <p class="reveal-item">Explore our resources, no email required.</p>
      <div class="cta-actions reveal-item">
        <a href="/wellness-portal" class="btn btn-primary">Wellness Portal</a>
        <a href="/mission" class="btn btn-ghost">Our Mission</a>
      </div>
    </div>
  </section>

  <!-- Show success message if ?sent=true -->
  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get('sent') === 'true') {
        var card = document.querySelector('.contact-card');
        var success = document.getElementById('contact-success');
        if (card) card.hidden = true;
        if (success) {
          success.hidden = false;
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    })();
  </script>

</Layout>
