      grid-template-columns: repeat(4, 1fr);
      gap: 1.1rem;
    }
    @media (max-width: 900px) { .calm-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 620px) { .calm-grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; } }

    .calm-card {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 2 / 3;
      border: 0;
      padding: 0;
      border-radius: 16px;
