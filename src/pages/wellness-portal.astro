    }

    .wp-info h2 {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 2vw, 1.9rem);
      font-weight: 500;
      color: var(--dark-grey);
      letter-spacing: -0.015em;
    }
    .wp-info p {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--dark-grey);
      opacity: 0.85;
      max-width: 440px;
    }
    .wp-info-cta {
      margin-top: 0.4rem;
