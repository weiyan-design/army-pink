  <!-- ===== HERO STYLES (scoped to this page) =====
       Base .hero / .hero-glass / .hero-wave / .hero-flower rules live in
       public/styles.css under "Wellness Portal Hero". The block below only adds
       the YouTube iframe background (the original used a local <video>). -->
  <style>
    /* YouTube embed as a full-bleed hero background.
       The iframe is oversized + centered so a 16:9 embed covers the hero box
       without letterboxing; .hero (overflow:hidden) clips the overflow.
       pointer-events:none keeps the embed non-interactive — clicks pass through. */
    .hero-video-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: var(--dark-grey);
    }
    .hero-video-bg iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100vw;
      height: 56.25vw;        /* 16:9 derived from width */
      min-width: 177.78vh;    /* 16:9 derived from height — guarantees vertical cover */
      min-height: 100vh;
      transform: translate(-50%, -50%);
      border: 0;
      pointer-events: none;
    }

    /* ───────── Calm Room shelves (Netflix-style rows, cream aesthetic) ───────── */
    .calm-shelves {
      padding: 4.5rem 0 3rem;
      background: var(--cream);
    }
    .calm-shelves-head {
      text-align: center;
      max-width: 560px;
      margin: 0 auto 2.5rem;
      padding: 0 1.5rem;
    }
    .calm-shelves-head h2 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      font-weight: 500;
      color: var(--dark-grey);
      letter-spacing: -0.02em;
      margin-top: 0.6rem;
    }

    .calm-row-wrap { margin-bottom: 2.5rem; }
    .calm-shelf-title {
      font-family: var(--font-display);
      font-size: clamp(1.1rem, 2vw, 1.45rem);
      font-weight: 500;
      color: var(--dark-grey);
      letter-spacing: -0.01em;
      margin: 0 0 0.9rem;
      padding: 0 max(1.5rem, calc((100vw - 1200px) / 2));
    }

    .calm-row-scroll { position: relative; }
    .calm-row {
      list-style: none;
      margin: 0;
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      padding: 0.4rem max(1.5rem, calc((100vw - 1200px) / 2));
      scrollbar-width: none;
    }
    .calm-row::-webkit-scrollbar { display: none; }
    .calm-row > li { flex: 0 0 auto; margin: 0; }

    .calm-card {
      position: relative;
      display: block;
      width: clamp(220px, 26vw, 300px);
      aspect-ratio: 16 / 9;
      border: 0;
      padding: 0;
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
      background: rgba(104, 101, 101, 0.12);
      box-shadow: 0 4px 14px rgba(104, 101, 101, 0.10);
      transition: transform 320ms ease, box-shadow 320ms ease;
    }
    .calm-card:hover,
    .calm-card:focus-visible {
      transform: translateY(-4px) scale(1.015);
      box-shadow: 0 12px 28px rgba(104, 101, 101, 0.22);
    }
    .calm-card-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms ease;
    }
    .calm-card:hover .calm-card-img { transform: scale(1.07); }
    .calm-card-grad {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(20, 18, 18, 0.82) 0%, rgba(20, 18, 18, 0.18) 38%, transparent 62%);
    }
    .calm-card-title {
      position: absolute;
      left: 0.9rem;
      right: 0.9rem;
      bottom: 0.8rem;
      color: #fff;
      font-size: 0.86rem;
      line-height: 1.35;
      font-weight: 500;
      text-align: left;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .calm-card-play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.8);
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      color: var(--dark-grey);
      opacity: 0;
      transition: opacity 280ms ease, transform 280ms ease;
      padding-left: 3px;
    }
    .calm-card:hover .calm-card-play,
    .calm-card:focus-visible .calm-card-play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .calm-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid rgba(104, 101, 101, 0.18);
      background: rgba(253, 251, 247, 0.92);
      color: var(--dark-grey);
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(104, 101, 101, 0.16);
      transition: background 200ms ease;
    }
    .calm-arrow:hover { background: #fff; }
    .calm-arrow-prev { left: 0.6rem; }
    .calm-arrow-next { right: 0.6rem; }
    @media (max-width: 768px) {
      .calm-arrow { display: none; }   /* touch users swipe */
    }

    /* ───────── Lightbox modal ───────── */
    .calm-modal {
      position: fixed;
      inset: 0;
      z-index: 1300;          /* above nav (1100), below safe-exit (9000) */
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(1rem, 5vw, 4rem);
      opacity: 0;
      visibility: hidden;
      transition: opacity 250ms ease, visibility 250ms ease;
    }
    .calm-modal.is-open { opacity: 1; visibility: visible; }
    .calm-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 18, 18, 0.84);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
    }
    .calm-modal-dialog {
      position: relative;
      width: min(960px, 100%);
    }
    .calm-modal-frame {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    .calm-modal-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .calm-modal-title {
      color: rgba(255, 255, 255, 0.92);
      text-align: center;
      margin-top: 1rem;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
    }
    .calm-modal-close {
      position: absolute;
      top: -2.6rem;
      right: 0;
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      transition: background 200ms ease;
    }
    .calm-modal-close:hover { background: rgba(255, 255, 255, 0.28); }
  </style>

  <!-- ===== HERO SCRIPT — flower scroll rotation =====
       The daisy below the wave rotates 0 → 180° (clockwise) as you scroll
       through roughly the first viewport. .hero-flower has will-change:transform. -->
  <script is:inline>
    (() => {
      const flower = document.querySelector('.hero-flower');
      if (!flower) return;
      const onScroll = () => {
        const deg = Math.min(window.scrollY / window.innerHeight, 1) * 180;
        flower.style.transform = 'rotate(' + deg.toFixed(2) + 'deg)';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>

  <!-- ===== CALM ROOM SHELVES + LIGHTBOX SCRIPT ===== -->
  <script is:inline>
    (() => {
      // Horizontal arrow scrolling per shelf
      document.querySelectorAll('.calm-row-scroll').forEach(scope => {
        const row = scope.querySelector('.calm-row');
        if (!row) return;
        const step = () => Math.max(row.clientWidth * 0.8, 240);
        const prev = scope.querySelector('.calm-arrow-prev');
        const next = scope.querySelector('.calm-arrow-next');
        if (prev) prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: 'smooth' }));
        if (next) next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: 'smooth' }));
      });

      // Lightbox modal
      const modal = document.getElementById('calmModal');
      if (!modal) return;
      const frame    = document.getElementById('calmModalFrame');
      const titleEl  = document.getElementById('calmModalTitle');
      const closeBtn = modal.querySelector('.calm-modal-close');
      const backdrop = modal.querySelector('.calm-modal-backdrop');
      let lastFocus = null;

      function openVideo(id, title) {
        if (!id) return;
        lastFocus = document.activeElement;
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = title || 'Video player';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        frame.innerHTML = '';
        frame.appendChild(iframe);
        titleEl.textContent = title || '';
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        if (closeBtn) closeBtn.focus();
      }
      function closeVideo() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        frame.innerHTML = '';   // unmount iframe → stops playback
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      document.querySelectorAll('.calm-card').forEach(card => {
        card.addEventListener('click', () => openVideo(card.dataset.youtubeId, card.dataset.title));
      });
      if (closeBtn) closeBtn.addEventListener('click', closeVideo);
      if (backdrop) backdrop.addEventListener('click', closeVideo);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeVideo();
      });
    })();
  </script>

