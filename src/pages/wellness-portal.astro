---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Wellness Portal — Army Pink">

  <!-- ===== HERO: COVERFLOW CAROUSEL ===== -->
  <div class="wp-hub-scroll-wrap" id="wpHubWrap">
    <section class="wp-hub" id="home">
      <canvas class="wp-hub-bg-canvas" id="wpHubBgCanvas"></canvas>

      <div class="wp-stage" id="wpStage">
        <div class="wp-arch" data-arch="0">
          <svg viewBox="0 0 320 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              <clipPath id="wpArchClip-0" clipPathUnits="userSpaceOnUse">
                <path id="wpArchPath-0" d="" />
              </clipPath>
            </defs>
            <image href="https://images.unsplash.com/photo-1545389336-cf090694435e?w=900&q=80"
                   x="0" y="0" width="320" height="400"
                   preserveAspectRatio="xMidYMid slice"
                   clip-path="url(#wpArchClip-0)" />
          </svg>
        </div>
        <div class="wp-arch" data-arch="1">
          <svg viewBox="0 0 320 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              <clipPath id="wpArchClip-1" clipPathUnits="userSpaceOnUse">
                <path id="wpArchPath-1" d="" />
              </clipPath>
            </defs>
            <image href="https://images.unsplash.com/photo-1499209974431-9dddcece7f88?w=900&q=80"
                   x="0" y="0" width="320" height="400"
                   preserveAspectRatio="xMidYMid slice"
                   clip-path="url(#wpArchClip-1)" />
          </svg>
        </div>
        <div class="wp-arch" data-arch="2">
          <svg viewBox="0 0 320 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              <clipPath id="wpArchClip-2" clipPathUnits="userSpaceOnUse">
                <path id="wpArchPath-2" d="" />
              </clipPath>
            </defs>
            <image href="https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=900&q=80"
                   x="0" y="0" width="320" height="400"
                   preserveAspectRatio="xMidYMid slice"
                   clip-path="url(#wpArchClip-2)" />
          </svg>
        </div>
      </div>

      <div class="wp-info-stack">
        <div class="wp-info is-active" data-info="0">
          <h2>The Calm Room</h2>
          <p>Pause and ground. Soft soundscapes, breathing, and quiet visuals for the moments that feel like too much.</p>
          <a href="/wellness-portal/calm-room" class="wp-info-cta" data-room="calm-room">Step inside →</a>
        </div>
        <div class="wp-info" data-info="1">
          <h2>Pathway to Freedom Library</h2>
          <p>Workbooks, guides, and the flagship 28-Day Journey — organized by what you need today.</p>
          <a href="/wellness-portal/library" class="wp-info-cta" data-room="library">Step inside →</a>
        </div>
        <div class="wp-info" data-info="2">
          <h2>Wellness Programs</h2>
          <p>One-year free access to partner platforms — guided practices, healing classes, and trauma-informed experts.</p>
          <a href="/wellness-portal/wellness-experiences" class="wp-info-cta" data-room="experiences">Step inside →</a>
        </div>
      </div>

      <div class="wp-dot-rail">
        <button class="wp-dot is-active" data-dot="0" aria-label="Calm Room"></button>
        <button class="wp-dot" data-dot="1" aria-label="Resource Library"></button>
        <button class="wp-dot" data-dot="2" aria-label="Wellness Programs"></button>
        <div class="wp-dot-counter" id="wpDotCounter">1 / 3</div>
      </div>
    </section>
  </div>

  <!-- ===== ARCH OPEN/CLOSE OVERLAY ===== -->
  <!-- Overlay container holds only the animating arch (the photo/clip clone).
       The close button sits as a sibling so it isn't tied to the arch's opacity. -->
  <div class="wp-overlay" id="wpOverlay" aria-hidden="true">
    <div class="wp-overlay-arch" id="wpOverlayArch">
      <svg viewBox="0 0 320 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <clipPath id="wpOverlayClip" clipPathUnits="userSpaceOnUse">
            <path id="wpOverlayPath" d="" />
          </clipPath>
        </defs>
        <image id="wpOverlayImage" href=""
               x="0" y="0" width="320" height="400"
               preserveAspectRatio="xMidYMid slice"
               clip-path="url(#wpOverlayClip)" />
      </svg>
    </div>
  </div>
  <!-- Close button removed — back navigation now lives on each sub-page -->


  <!-- ===== EMPOWERING SERIES ===== -->
  <section class="section section-empowering" id="wellness">
    <div class="container">
      <div class="empowering-grid">
        <div class="empowering-image reveal-item">
          <img src="/img/empowering-hero.jpg" alt="Yoga silhouette at sunset" />
        </div>
        <div class="empowering-text">
          <span class="pill-label reveal-item">Empowering Series</span>
          <h2 class="reveal-item">Your body kept you safe.<br>Now let it rest.</h2>
          <p class="reveal-item">
            Movement that meets you where you are, whether you're stepping onto
            the mat for the first time or finding your way back.
          </p>
          <div class="thumb-row-wrap">
            <button class="thumb-arrow thumb-arrow-prev" aria-label="Scroll left">&lsaquo;</button>
            <div class="thumb-row">
              <a href="https://www.doyogawithme.com/yoga-series/yoga-program-calm-chaos" target="_blank" rel="noopener" class="thumb-card reveal-item">
                <img src="/img/thumb-calm-chaos.jpg" alt="Calm in the Chaos" />
                <div class="thumb-overlay">
                  <span class="thumb-title">Calm in the Chaos</span>
                  <span class="thumb-meta">Intermediate</span>
                </div>
              </a>
              <a href="https://www.doyogawithme.com/yoga-series/busy-place-quiet-mind" target="_blank" rel="noopener" class="thumb-card reveal-item">
                <img src="/img/thumb-quiet-mind.jpg" alt="Busy Place Quiet Mind" />
                <div class="thumb-overlay">
                  <span class="thumb-title">Busy Place Quiet Mind</span>
                  <span class="thumb-meta">All levels</span>
                </div>
              </a>
              <a href="https://www.doyogawithme.com/yoga-series/inner-strength-series" target="_blank" rel="noopener" class="thumb-card reveal-item">
                <img src="/img/thumb-inner-strength.jpg" alt="Inner Strength Series" />
                <div class="thumb-overlay">
                  <span class="thumb-title">Inner Strength</span>
                  <span class="thumb-meta">Intermediate</span>
                </div>
              </a>
            </div>
            <button class="thumb-arrow thumb-arrow-next" aria-label="Scroll right">&rsaquo;</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED CLASSES ===== -->
  <section class="section section-featured">
    <div class="container">
      <div class="featured-wrap">
        <button class="thumb-arrow thumb-arrow-prev" aria-label="Scroll left">&lsaquo;</button>
        <div class="featured-grid">
          <a href="https://www.doyogawithme.com/content/yoga-nidra-jennifer-piercy" target="_blank" rel="noopener" class="featured-card reveal-item">
            <span class="pill-label pill-small">Sleep Aids</span>
            <img src="/img/featured-yoga-nidra.jpg" alt="Yoga Nidra" />
            <div class="featured-content">
              <h3>Yoga Nidra</h3>
              <p class="featured-meta">Guided deep relaxation</p>
            </div>
          </a>
          <a href="https://www.doyogawithme.com/content/ease-into-sleep" target="_blank" rel="noopener" class="featured-card reveal-item">
            <span class="pill-label pill-small">Sleep Aids</span>
            <img src="/img/featured-ease-sleep.jpg" alt="Ease into Sleep" />
            <div class="featured-content">
              <h3>Ease into Sleep</h3>
              <p class="featured-meta">Floor-based gentle movement</p>
            </div>
          </a>
          <a href="https://www.doyogawithme.com/content/intro-box-breathing" target="_blank" rel="noopener" class="featured-card reveal-item">
            <span class="pill-label pill-small">Breathe Better</span>
            <img src="/img/featured-box-breathing.jpg" alt="Box Breathing" />
            <div class="featured-content">
              <h3>Box Breathing</h3>
              <p class="featured-meta">4-count calming technique</p>
            </div>
          </a>
          <a href="https://www.doyogawithme.com/content/guided-meditations-kids" target="_blank" rel="noopener" class="featured-card reveal-item">
            <span class="pill-label pill-small">For Kids</span>
            <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=600&q=80" alt="Kids Meditation" />
            <div class="featured-content">
              <h3>Kids Meditation</h3>
              <p class="featured-meta">Beginner &middot; 10 min</p>
            </div>
          </a>
          <a href="https://www.doyogawithme.com/content/kids-jungle-walk" target="_blank" rel="noopener" class="featured-card reveal-item">
            <span class="pill-label pill-small">For Kids</span>
            <img src="https://images.unsplash.com/photo-1588286840104-8957b019727f?w=600&q=80" alt="Kids Yoga" />
            <div class="featured-content">
              <h3>Kids Yoga</h3>
              <p class="featured-meta">Beginner &middot; 20 min</p>
            </div>
          </a>
        </div>
        <button class="thumb-arrow thumb-arrow-next" aria-label="Scroll right">&rsaquo;</button>
      </div>
    </div>
  </section>

  <!-- ===== WELLNESS PROGRAMS ===== -->
  <section class="section section-programs">
    <div class="container">
      <div class="empowering-grid empowering-grid-reversed">
        <div class="empowering-text">
          <span class="pill-label reveal-item">Wellness Programs</span>
          <h2 class="reveal-item">Healing isn't one size fits all. Find what fits you.</h2>
          <p class="reveal-item">
            Structured programs with real support - from managing anxiety to navigating
            life changes. Bursaries available so cost is never a barrier.
          </p>
          <div class="thumb-row-wrap">
            <button class="thumb-arrow thumb-arrow-prev" aria-label="Scroll left">&lsaquo;</button>
            <div class="thumb-row">
              <a href="https://courses.doyogawithme.com/courses/mindful-about-menopause-support-online-program" target="_blank" rel="noopener" class="thumb-card reveal-item">
                <img src="/img/thumb-menopause.jpg" alt="Mindful about Menopause" />
                <div class="thumb-overlay">
                  <span class="thumb-title">Mindful about Menopause</span>
                  <span class="thumb-meta">Program</span>
                </div>
              </a>
              <a href="https://courses.doyogawithme.com/courses/let-go-of-anxiety-and-fear" target="_blank" rel="noopener" class="thumb-card reveal-item">
                <img src="/img/thumb-anxiety.jpg" alt="Let Go of Anxiety" />
                <div class="thumb-overlay">
                  <span class="thumb-title">Let Go of Anxiety</span>
                  <span class="thumb-meta">Program</span>
                </div>
              </a>
            </div>
            <button class="thumb-arrow thumb-arrow-next" aria-label="Scroll right">&rsaquo;</button>
          </div>
        </div>
        <div class="empowering-image reveal-item">
          <img src="/img/programs-hero.jpg" alt="Person meditating outdoors" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SURVIVOR STORIES ===== -->
  <section class="section section-stories" id="stories">
    <div class="container">
      <div class="stories-grid">
        <div class="stories-text">
          <span class="pill-label reveal-item">Survivor Stories</span>
          <h2 class="reveal-item">Reflections From<br>Our <em>Community</em></h2>
          <p class="reveal-item">
            Every journey is different. These are the voices of survivors who found
            their way forward - in their own time, on their own terms.
          </p>
          <a href="#" class="btn btn-primary reveal-item">Share your story</a>
        </div>
        <div class="stories-deck-area">
          <div class="stories-deck" id="stories-deck">
            <div class="story-card story-card-active" data-index="0">
              <img src="/img/story-1.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="1">
              <img src="/img/story-2.png" alt="Survivor portrait" />
            </div>
            <div class="story-card" data-index="2">
              <img src="/img/story-3.png" alt="Survivor portrait" />
            </div>
          </div>
          <div class="story-quote-row">
            <button class="stories-btn stories-prev" aria-label="Previous story">
              <i data-lucide="chevron-left" aria-hidden="true"></i>
            </button>
            <div class="story-quote-box" id="story-quote-box">
              <div class="story-quote story-quote-active" data-index="0">
                <p>"I didn't think I deserved peace. The breathing exercises helped me realize
                  my body had been holding its breath for years. Learning to exhale again
                  changed everything."</p>
                <div class="story-author">
                  <strong>Sarah M.</strong>
                  <span>Survivor &middot; 2 years post-separation</span>
                </div>
              </div>
              <div class="story-quote" data-index="1">
                <p>"Some days I still feel the pull to go back. But the community reminded me
                  that missing someone who hurt you doesn't make you weak - it makes you human.
                  That changed how I talked to myself."</p>
                <div class="story-author">
                  <strong>A Survivor</strong>
                  <span>Sharing anonymously</span>
                </div>
              </div>
              <div class="story-quote" data-index="2">
                <p>"The yoga sessions gave me my body back. I used to flinch at everything.
                  Now I can sit in stillness without scanning for danger. I didn't know
                  that was possible."</p>
                <div class="story-author">
                  <strong>Maria L.</strong>
                  <span>Wellness program participant</span>
                </div>
              </div>
            </div>
            <button class="stories-btn stories-next" aria-label="Next story">
              <i data-lucide="chevron-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT ARMY PINK ===== -->
  <section class="section section-mission" id="mission">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-text">
          <span class="overline">Our Mission</span>
          <h2>We don't sell healing.<br>We connect you to it.</h2>
          <p>
            Army Pink is a 501(c)(3) nonprofit supporting domestic violence survivors
            through safety-centered transportation, concierge support, and wellness resources.
          </p>
          <p>
            Our <strong>Pathway to Freedom</strong> program provides donation-based Freedom Rides —
            immediate safe transportation when you need it most — plus connections to
            ongoing wellness support for the road ahead.
          </p>
          <p class="quiet">Based in California. Serving survivors nationwide.</p>
        </div>
        <div class="mission-values">
          <div class="value">
            <span class="value-number">01</span>
            <div>
              <h4>Safety First</h4>
              <p>Every decision we make starts with your safety.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">02</span>
            <div>
              <h4>Survivor-Led</h4>
              <p>People who understand the journey shape our work.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">03</span>
            <div>
              <h4>No Barriers</h4>
              <p>Survivors never pay. Supporters make that possible.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== OVERLAYS (kept for future use) ===== -->

  <div class="overlay" id="overlay-phase-1" aria-hidden="true" role="dialog" aria-label="Resources for when you just left">
    <div class="overlay-backdrop"></div>
    <div class="overlay-panel">
      <button class="overlay-close" aria-label="Close">&times;</button>
      <div class="overlay-content">
        <span class="overline">Phase 1: Immediate Aftermath</span>
        <h2>You're safe now. That matters.</h2>
        <p>The confusion you're feeling - the fog, the fear, the guilt tangled with relief - is your mind processing what you survived. It's not a flaw. It's a natural response.</p>
        <div class="carousel-row"><h3 class="carousel-label">Something gentle for your ears</h3><div class="carousel"><button class="carousel-arrow carousel-prev" aria-label="Scroll left">&lsaquo;</button><div class="carousel-track"><a href="#" class="carousel-card"><span class="carousel-type">Meditation</span><h4>Guided Meditation for Victims of Domestic Abuse</h4><p class="carousel-source">Fragrant Heart</p></a><a href="#" class="carousel-card"><span class="carousel-type">Meditation</span><h4>Grounding Meditation for Trauma</h4><p class="carousel-source">Insight Timer - Dr. Amelia Kelley</p></a><a href="#" class="carousel-card"><span class="carousel-type">Meditation</span><h4>I Am Safe: Healing from Terror/Trauma</h4><p class="carousel-source">Insight Timer</p></a><a href="#" class="carousel-card"><span class="carousel-type">Podcast</span><h4>4 Steps to Break a Trauma Bond</h4><p class="carousel-source">The Relationship Recovery Podcast - EP102</p></a><a href="#" class="carousel-card"><span class="carousel-type">Podcast</span><h4>Love and Abuse</h4><p class="carousel-source">Paul Colaianni</p></a></div><button class="carousel-arrow carousel-next" aria-label="Scroll right">&rsaquo;</button></div></div>
        <div class="carousel-row"><h3 class="carousel-label">Words that understand</h3><div class="carousel"><button class="carousel-arrow carousel-prev" aria-label="Scroll left">&lsaquo;</button><div class="carousel-track"><a href="#" class="carousel-card"><span class="carousel-type">Article</span><h4>Stages of Recovery After Trauma</h4><p class="carousel-source">DomesticShelters.org</p></a><a href="#" class="carousel-card"><span class="carousel-type">Article</span><h4>What Is Trauma Bonding?</h4><p class="carousel-source">DomesticShelters.org</p></a><a href="#" class="carousel-card"><span class="carousel-type">Guide</span><h4>I've Left and I Need Support</h4><p class="carousel-source">Women's Aid - The Survivor's Handbook</p></a><a href="#" class="carousel-card"><span class="carousel-type">Article</span><h4>5 Powerful Self-Care Tips for Abuse and Trauma Survivors</h4><p class="carousel-source">The Hotline</p></a><a href="#" class="carousel-card"><span class="carousel-type">Guide</span><h4>Create Your Personal Safety Plan</h4><p class="carousel-source">The Hotline</p></a></div><button class="carousel-arrow carousel-next" aria-label="Scroll right">&rsaquo;</button></div></div>
        <div class="carousel-row"><h3 class="carousel-label">Stories like yours</h3><div class="carousel"><button class="carousel-arrow carousel-prev" aria-label="Scroll left">&lsaquo;</button><div class="carousel-track"><a href="#" class="carousel-card"><span class="carousel-type">TED Talk</span><h4>Why Domestic Violence Victims Don't Leave</h4><p class="carousel-source">Leslie Morgan Steiner</p></a><a href="#" class="carousel-card"><span class="carousel-type">TEDx Talk</span><h4>I Left on a Tuesday</h4><p class="carousel-source">Chiara Lisowski</p></a><a href="#" class="carousel-card"><span class="carousel-type">YouTube Channel</span><h4>Dr. Ramani Durvasula</h4><p class="carousel-source">YouTube</p></a><a href="#" class="carousel-card"><span class="carousel-type">TEDx Talk</span><h4>Domestic Violence: What Everyone Needs to Know</h4><p class="carousel-source">Hannah Petrillo</p></a><a href="#" class="carousel-card"><span class="carousel-type">Exercise</span><h4>Trauma-Sensitive 5-4-3-2-1 Grounding Exercise</h4><p class="carousel-source">Insight Timer</p></a></div><button class="carousel-arrow carousel-next" aria-label="Scroll right">&rsaquo;</button></div></div>
      </div>
    </div>
  </div>

  <div class="overlay" id="overlay-phase-2" aria-hidden="true" role="dialog" aria-label="Resources for when you feel stuck">
    <div class="overlay-backdrop"></div>
    <div class="overlay-panel">
      <button class="overlay-close" aria-label="Close">&times;</button>
      <div class="overlay-content">
        <span class="overline">Phase 2: The Middle</span>
        <h2>Stuck doesn't mean broken.</h2>
        <p>You're safe, but the weight of everything is surfacing. Grief for the relationship, anger you couldn't express before, and the question "who am I without this?" are all part of this phase.</p>
        <div class="overlay-cards"><div class="overlay-card"><h4>Grief without closure</h4><p>You're mourning someone still alive, a relationship that held both love and violence. Society rarely validates this grief.</p></div><div class="overlay-card"><h4>Anger is arriving</h4><p>Anger was unsafe to express during the relationship. Feeling it now is healthy - even when it's frightening.</p></div><div class="overlay-card"><h4>Identity is rebuilding</h4><p>Your preferences, opinions, and sense of self were systematically eroded. Rediscovering them takes time and patience.</p></div></div>
        <div class="overlay-resources"><h3>What might help right now</h3><a href="#wellness" class="overlay-link" data-close-overlay>Trauma-informed yoga for body reconnection &rarr;</a><a href="#wellness" class="overlay-link" data-close-overlay>Mindfulness practices for self-exploration &rarr;</a><a href="#community" class="overlay-link" data-close-overlay>Daily check-ins with the community &rarr;</a></div>
      </div>
    </div>
  </div>

  <div class="overlay" id="overlay-phase-3" aria-hidden="true" role="dialog" aria-label="Resources for rebuilding">
    <div class="overlay-backdrop"></div>
    <div class="overlay-panel">
      <button class="overlay-close" aria-label="Close">&times;</button>
      <div class="overlay-content">
        <span class="overline">Phase 3: Rebuilding</span>
        <h2>You're becoming someone new.</h2>
        <p>Rebuilding trust, setting boundaries, navigating new relationships - this phase is simultaneously liberating and terrifying. Growth and pain coexist here, and that's okay.</p>
        <div class="overlay-cards"><div class="overlay-card"><h4>Boundaries are new</h4><p>You may swing between walls and no boundaries at all. Learning the middle ground is a practice, not a destination.</p></div><div class="overlay-card"><h4>Trust takes time</h4><p>Learning to distinguish healthy from unhealthy patterns - in others and in yourself - is part of earned secure attachment.</p></div><div class="overlay-card"><h4>Post-traumatic growth</h4><p>Deeper empathy, clarity about values, new life directions. Not universal, but possible - and it coexists with ongoing pain.</p></div></div>
        <div class="overlay-resources"><h3>What might help right now</h3><a href="#wellness" class="overlay-link" data-close-overlay>Wellness programs for ongoing healing &rarr;</a><a href="#community" class="overlay-link" data-close-overlay>Peer support and mentorship &rarr;</a><a href="#community" class="overlay-link" data-close-overlay>Weekly community events &rarr;</a></div>
      </div>
    </div>
  </div>

  <div class="overlay" id="overlay-breathing" aria-hidden="true" role="dialog" aria-label="Guided breathing resources">
    <div class="overlay-backdrop"></div>
    <div class="overlay-panel">
      <button class="overlay-close" aria-label="Close">&times;</button>
      <div class="overlay-content">
        <span class="overline">Learn to Breathe Better</span>
        <h2>Calm starts with a single breath.</h2>
        <p>When your body is stuck in fight-or-flight, breathing is the fastest way back to safety. These exercises are simple, short, and available anytime you need them.</p>
        <div class="breathing-exercise" role="region" aria-label="Guided breathing exercise"><h3>Try it now: Box Breathing</h3><p>A simple grounding exercise you can use anytime. Follow the animation at your own pace.</p><div class="breath-box" id="breath-box"><div class="breath-circle" id="breath-circle"></div><p class="breath-instruction" id="breath-instruction"></p></div><button class="btn btn-outline" id="breath-toggle">Start breathing exercise</button></div>
