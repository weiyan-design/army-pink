      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0 0 1.6rem;
    }
    .calm-wordmark .cw-word { display: inline-block; white-space: nowrap; }
    .calm-wordmark .cw-char {
      display: inline-block;
      opacity: 0;
      filter: blur(18px);
      transform: translateY(0.18em) scale(1.06);
      transition: opacity 820ms ease, filter 820ms ease, transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, filter, transform;
    }
    .calm-wordmark.is-revealed .cw-char {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .calm-wordmark .cw-char {
        opacity: 1;
        filter: none;
        transform: none;
        transition: none;
      }
    }
    .calm-wordmark .cw-space { display: inline-block; width: 0.26em; }
    .calm-intro {
      max-width: 680px;
      margin: 0 auto;
    }
    .calm-intro p {
      color: var(--dark-grey);
      font-size: clamp(0.95rem, 1.6vw, 1.05rem);
      line-height: 1.7;
    }
    .calm-intro p + p { margin-top: 1.2rem; }

    /* Tabs */
    .calm-tabs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.5rem;
      margin-bottom: 2rem;
    }
    .calm-tabs::-webkit-scrollbar { display: none; }
    @media (min-width: 900px) {
      .calm-tabs { justify-content: center; flex-wrap: wrap; overflow: visible; }
    }
    .calm-tab {
      flex: 0 0 auto;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: transparent;
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      padding: 0.5rem 1.05rem;
      border-radius: 999px;
