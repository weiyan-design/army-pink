---
import Layout from '../layouts/Layout.astro';
import { calmRoomShelves } from '../data/calm-room.js';

// Wordmark pre-split into char spans at build time so the blur-in reveal has no
// flash (letters hidden via CSS from first paint). Displayed as one word
// "TheCalmRoom"; aria-label keeps it readable for assistive tech.
const WORDMARK = 'TheCalmRoom';
const WORDMARK_LABEL = 'The Calm Room';
let _cwIndex = 0;
const wordmarkWords = WORDMARK.split(' ').map(word => ({
  chars: Array.from(word).map(ch => ({ ch, i: _cwIndex++ })),
}));
---

<Layout title="The Calm Room — Army Pink">

  <!-- ===== HERO: full-screen sanctuary video, fades into the black collection ===== -->
  <header class="hero" id="home">
    <div class="hero-video-bg" aria-hidden="true">
      <iframe
        src="https://www.youtube.com/embed/hms0chui1NM?autoplay=1&mute=1&controls=0&loop=1&playlist=hms0chui1NM&playsinline=1&modestbranding=1&rel=0&showinfo=0&disablekb=1&iv_load_policy=3&fs=0"
        title="Calm Room ambience"
        frameborder="0"
        tabindex="-1"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen></iframe>
    </div>
    <div class="hero-brand">
      <h2 class="calm-wordmark" aria-label={WORDMARK_LABEL}>
        {wordmarkWords.map((word, wi) => (
          <>
            <span class="cw-word">{word.chars.map(c => (
              <span class="cw-char" style={`transition-delay:${c.i * 55}ms`} aria-hidden="true">{c.ch}</span>
            ))}</span>
            {wi < wordmarkWords.length - 1 && <span class="cw-space" aria-hidden="true"></span>}
          </>
        ))}
      </h2>
      <div class="calm-intro">
        <p>This is a softly curated sanctuary created for survivors of trauma. Every piece of content — from healing music and movement to sacred words and therapy insights — has been selected for its ability to soothe, restore, and uplift. Come as you are.</p>
        <p>Stay as long as you need. This space is yours.</p>
      </div>
    </div>
  </header>

  <!-- No-JS fallback: show the wordmark letters (JS handles the animated reveal). -->
  <noscript>
    <style>.calm-wordmark .cw-char { opacity: 1 !important; filter: none !important; transform: none !important; }</style>
  </noscript>

  <!-- ===== CALM ROOM COLLECTION (black, tabbed, filterable grid) ===== -->
  <section class="calm-collection" aria-label="Calm Room video collection">
    <div class="calm-collection-inner">
      <div class="calm-tabs" role="tablist" aria-label="Categories">
        <button class="calm-tab is-active" type="button" role="tab" data-cat="all" aria-selected="true">All</button>
        {calmRoomShelves.map((shelf, i) => (
          <button class="calm-tab" type="button" role="tab" data-cat={String(i)} aria-selected="false">{shelf.title}</button>
        ))}
      </div>

      <div class="calm-grid" id="calmGrid">
        {calmRoomShelves.flatMap((shelf, i) =>
          shelf.videos.filter(v => v.youtubeId).map(v => (
            <button class="calm-card" type="button" data-cat={String(i)} data-youtube-id={v.youtubeId} data-title={v.title}>
              {v.cover ? (
                <img class="calm-card-img" src={v.cover} alt="" loading="lazy" />
              ) : (
                <img
                  class="calm-card-img"
                  src={`https://img.youtube.com/vi/${v.youtubeId}/maxresdefault.jpg`}
                  onload={`if(this.naturalWidth<600){this.onload=null;this.src='https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg'}`}
                  onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg'`}
                  alt=""
                  loading="lazy"
                />
              )}
              <span class="calm-card-grad" aria-hidden="true"></span>
              <span class="calm-card-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              </span>
              <span class="calm-card-meta">
                <span class="calm-card-eyebrow">{shelf.title}</span>
                <span class="calm-card-title">{v.title}</span>
              </span>
            </button>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- ===== CALM ROOM LIGHTBOX ===== -->
  <div class="calm-modal" id="calmModal" role="dialog" aria-modal="true" aria-label="Video player" aria-hidden="true">
    <div class="calm-modal-backdrop"></div>
    <div class="calm-modal-dialog">
      <button class="calm-modal-close" type="button" aria-label="Close video">&times;</button>
      <div class="calm-modal-frame" id="calmModalFrame"></div>
      <p class="calm-modal-title" id="calmModalTitle"></p>
    </div>
  </div>

  <!-- ===== HERO STYLES (scoped to this page) =====
       Base .hero / .hero-glass / .hero-wave / .hero-flower rules live in
       public/styles.css under "Wellness Portal Hero". The block below only adds
       the YouTube iframe background (the original used a local <video>). -->
  <style>
    /* YouTube embed as a full-bleed hero background.
       The iframe is oversized + centered so a 16:9 embed covers the hero box
       without letterboxing; .hero (overflow:hidden) clips the overflow.
       pointer-events:none keeps the embed non-interactive — clicks pass through. */
    .hero-video-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: var(--dark-grey);
    }
    .hero-video-bg iframe {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100vw;
      height: 56.25vw;        /* 16:9 derived from width */
      min-width: 177.78vh;    /* 16:9 derived from height — guarantees vertical cover */
      min-height: 100vh;
      transform: translate(-50%, -50%);
      border: 0;
      pointer-events: none;
    }

    /* ───────── Hero dark fade — melts the video into the black collection ───────── */
    .hero { position: relative; min-height: 100vh; }
    .hero::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 65%;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 30%, rgba(0, 0, 0, 0.8) 62%, #000 88%);
      z-index: 1;
      pointer-events: none;
    }

    /* ───────── Calm Room collection (black, tabbed, filterable portrait grid) ───────── */
    .calm-collection {
      position: relative;
      background: #000;
      padding: clamp(2rem, 4vw, 3rem) 0 clamp(3.5rem, 7vw, 6rem);
    }
    .calm-collection-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    /* Branding moment + intro — anchored to the bottom of the 100vh hero,
       overlapping the video (sits on the dark fade). */
    .hero-brand {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;            /* above the dark fade (z1) and video (z0) */
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 1.5rem clamp(1.75rem, 4.5vh, 3.5rem);
      text-align: center;
    }
    .calm-wordmark {
      font-family: var(--font-display);
      color: var(--dark-grey);
      font-size: clamp(2.6rem, 9vw, 6.5rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0 0 1.6rem;
    }
    .calm-wordmark .cw-word { display: inline-block; white-space: nowrap; }
    .calm-wordmark .cw-char {
      display: inline-block;
      opacity: 0;
      filter: blur(18px);
      transform: translateY(0.18em) scale(1.06);
      transition: opacity 820ms ease, filter 820ms ease, transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, filter, transform;
    }
    .calm-wordmark.is-revealed .cw-char {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .calm-wordmark .cw-char {
        opacity: 1;
        filter: none;
        transform: none;
        transition: none;
      }
    }
    .calm-wordmark .cw-space { display: inline-block; width: 0.26em; }
    .calm-intro {
      max-width: 680px;
      margin: 0 auto;
    }
    .calm-intro p {
      color: var(--dark-grey);
      font-size: clamp(0.95rem, 1.6vw, 1.05rem);
      line-height: 1.7;
    }
    .calm-intro p + p { margin-top: 1.2rem; }

    /* Tabs */
    .calm-tabs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.5rem;
      margin-bottom: 2rem;
    }
    .calm-tabs::-webkit-scrollbar { display: none; }
    @media (min-width: 900px) {
      .calm-tabs { justify-content: center; flex-wrap: wrap; overflow: visible; }
    }
    .calm-tab {
      flex: 0 0 auto;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: transparent;
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      padding: 0.5rem 1.05rem;
      border-radius: 999px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 220ms ease, color 220ms ease, border-color 220ms ease;
    }
    .calm-tab:hover { color: #fff; border-color: rgba(255, 255, 255, 0.32); }
    .calm-tab.is-active {
      background: var(--pink);
      border-color: var(--pink);
      color: #fff;
    }

    /* Grid */
    .calm-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.1rem;
    }
    @media (max-width: 900px) { .calm-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 620px) { .calm-grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; } }

    .calm-card {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 2 / 3;
      border: 0;
      padding: 0;
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      background: #15131a;
      transition: transform 320ms ease, box-shadow 320ms ease;
      will-change: transform, opacity;
    }
    .calm-card.is-hidden { display: none; }
    .calm-card:hover,
    .calm-card:focus-visible {
      transform: translateY(-4px);
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.5);
    }
    .calm-card-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 600ms ease;
    }
    .calm-card:hover .calm-card-img { transform: scale(1.06); }
    .calm-card-grad {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.86) 0%, rgba(0, 0, 0, 0.30) 38%, rgba(0, 0, 0, 0.05) 60%, transparent 78%);
    }
    .calm-card-meta {
      position: absolute;
      left: 0.95rem;
      right: 0.95rem;
      bottom: 0.95rem;
      text-align: left;
    }
    .calm-card-eyebrow {
      display: block;
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.62);
      margin-bottom: 0.3rem;
    }
    .calm-card-title {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: #fff;
      font-size: 0.98rem;
      line-height: 1.2;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .calm-card-play {
      position: absolute;
      top: 42%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.8);
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      color: #15131a;
      opacity: 0;
      transition: opacity 280ms ease, transform 280ms ease;
      padding-left: 3px;
    }
    .calm-card:hover .calm-card-play,
    .calm-card:focus-visible .calm-card-play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      .calm-card, .calm-card-img, .calm-card-play { transition: none; }
    }

    /* ───────── Lightbox modal ───────── */
    .calm-modal {
      position: fixed;
      inset: 0;
      z-index: 1300;          /* above nav (1100), below safe-exit (9000) */
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(1rem, 5vw, 4rem);
      opacity: 0;
      visibility: hidden;
      transition: opacity 250ms ease, visibility 250ms ease;
    }
    .calm-modal.is-open { opacity: 1; visibility: visible; }
    .calm-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 18, 18, 0.84);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
    }
    .calm-modal-dialog {
      position: relative;
      width: min(960px, 100%);
    }
    .calm-modal-frame {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    .calm-modal-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .calm-modal-title {
      color: rgba(255, 255, 255, 0.92);
      text-align: center;
      margin-top: 1rem;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
    }
    .calm-modal-close {
      position: absolute;
      top: -2.6rem;
      right: 0;
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      transition: background 200ms ease;
    }
    .calm-modal-close:hover { background: rgba(255, 255, 255, 0.28); }
  </style>

  <!-- ===== CALM ROOM COLLECTION + LIGHTBOX SCRIPT ===== -->
  <script is:inline>
    (() => {
      // Branding moment: reveal the pre-split "The Calm Room" letters (blur + rise)
      // when scrolled into view. Letters are rendered + hidden at build time, so
      // there's no flash; reduced-motion (CSS) and no-JS (<noscript>) show them plainly.
      const wordmark = document.querySelector('.calm-wordmark');
      if (wordmark) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) { wordmark.classList.add('is-revealed'); io.disconnect(); }
          });
        }, { threshold: 0.35 });
        io.observe(wordmark);
      }

      // Tab filtering with a FLIP shuffle: matching cards slide to their new
      // grid positions, newly revealed cards fade + rise in.
      const grid = document.getElementById('calmGrid');
      const tabs = Array.from(document.querySelectorAll('.calm-tab'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let currentCat = 'all';

      function filterTo(cat) {
        if (!grid || cat === currentCat) return;
        const cards = Array.from(grid.querySelectorAll('.calm-card'));
        const wasVisible = new Map();
        const first = new Map();
        cards.forEach(c => {
          const vis = !c.classList.contains('is-hidden');
          wasVisible.set(c, vis);
          if (vis) first.set(c, c.getBoundingClientRect());
        });
        cards.forEach(c => {
          const match = cat === 'all' || c.dataset.cat === cat;
          c.classList.toggle('is-hidden', !match);
        });
        currentCat = cat;
        if (reduce) return;
        cards.forEach(c => {
          if (c.classList.contains('is-hidden')) return;
          if (wasVisible.get(c)) {
            const last = c.getBoundingClientRect();
            const f = first.get(c);
            const dx = f.left - last.left;
            const dy = f.top - last.top;
            if (!dx && !dy) return;
            c.style.transition = 'none';
            c.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
            requestAnimationFrame(() => {
              c.style.transition = 'transform 520ms cubic-bezier(0.22,1,0.36,1)';
              c.style.transform = '';
            });
            setTimeout(() => { c.style.transition = ''; c.style.transform = ''; }, 600);
          } else {
            c.style.transition = 'none';
            c.style.opacity = '0';
            c.style.transform = 'translateY(14px) scale(0.96)';
            requestAnimationFrame(() => {
              c.style.transition = 'transform 460ms cubic-bezier(0.22,1,0.36,1), opacity 460ms ease';
              c.style.opacity = '1';
              c.style.transform = '';
            });
            setTimeout(() => { c.style.transition = ''; c.style.transform = ''; c.style.opacity = ''; }, 540);
          }
        });
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          filterTo(tab.dataset.cat);
        });
      });

      // Lightbox modal
      const modal = document.getElementById('calmModal');
      if (!modal) return;
      const frame    = document.getElementById('calmModalFrame');
      const titleEl  = document.getElementById('calmModalTitle');
      const closeBtn = modal.querySelector('.calm-modal-close');
      const backdrop = modal.querySelector('.calm-modal-backdrop');
      let lastFocus = null;

      function openVideo(id, title) {
        if (!id) return;
        lastFocus = document.activeElement;
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = title || 'Video player';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        // Inline fill styles: the scoped `.calm-modal-frame iframe` CSS rule
        // can't match a JS-created element (no data-astro-cid attribute).
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
        frame.innerHTML = '';
        frame.appendChild(iframe);
        titleEl.textContent = title || '';
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        if (closeBtn) closeBtn.focus();
      }
      function closeVideo() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        frame.innerHTML = '';   // unmount iframe → stops playback
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      document.querySelectorAll('.calm-card').forEach(card => {
        card.addEventListener('click', () => openVideo(card.dataset.youtubeId, card.dataset.title));
      });
      if (closeBtn) closeBtn.addEventListener('click', closeVideo);
      if (backdrop) backdrop.addEventListener('click', closeVideo);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeVideo();
      });
    })();
  </script>

</Layout>
