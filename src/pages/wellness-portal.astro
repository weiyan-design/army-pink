  <!-- ===== HERO STYLES (scoped to this page) ===== -->
  <style>
    .wp-hub-scroll-wrap {
      height: 400vh;
      position: relative;
    }

    .wp-hub {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0;
      gap: 1.5rem;
      overflow: hidden;
      background: var(--cream);
    }

    .wp-hub-bg-canvas {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      display: block;
      width: 100%;
      height: 100%;
    }

    .wp-stage {
      position: relative;
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
      perspective: 1500px;
      perspective-origin: 50% 50%;
