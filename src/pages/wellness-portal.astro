      will-change: transform, opacity;
    }
    .wp-arch svg { width: 100%; height: 100%; display: block; }

    .wp-info-stack {
      position: relative;
      width: 100%;
      max-width: 520px;
      min-height: 190px;
      text-align: center;
      flex: 0 0 auto;
      z-index: 2;
