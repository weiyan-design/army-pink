      z-index: 5;
    }
    .wp-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid var(--dark-grey);
      background: transparent;
      cursor: pointer;
      padding: 0;
      transition: background 300ms ease, transform 300ms ease;
    }
    .wp-dot.is-active {
      background: var(--dark-grey);
      transform: scale(1.4);
    }
    .wp-dot-counter {
      margin-top: 0.5rem;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dark-grey);
      opacity: 0.6;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 768px) {
      .wp-dot-rail { display: none; }
    }

    /* ───────── Arch open/close overlay ─────────
       The overlay container is a transparent positioning layer for the
       animating arch clone. We use `visibility` (instant) instead of
       `opacity` for the container so there's no fade-in flash when the
       source arch hands off to the clone. */
    .wp-overlay {
      position: fixed;
      inset: 0;
      z-index: 800;
      pointer-events: none;
      visibility: hidden;
    }
    .wp-overlay.is-open {
      visibility: visible;
      pointer-events: auto;
    }

    .wp-overlay-arch {
      position: fixed;
      opacity: 1;
      /* top/left/width/height inline-set by JS; transitions animate them.
         opacity transitions in lockstep with the expansion so the arch
         fades from 1 → 0 (open) or 0 → 1 (return) as it morphs. */
      transition:
        top    700ms cubic-bezier(0.65, 0, 0.35, 1),
        left   700ms cubic-bezier(0.65, 0, 0.35, 1),
        width  700ms cubic-bezier(0.65, 0, 0.35, 1),
        height 700ms cubic-bezier(0.65, 0, 0.35, 1),
        opacity 700ms cubic-bezier(0.65, 0, 0.35, 1);
      will-change: top, left, width, height, opacity;
    }
    .wp-overlay-arch svg { width: 100%; height: 100%; display: block; }
    .wp-overlay.is-arch-hidden .wp-overlay-arch { opacity: 0; }

    /* Carousel sibling UI fades while overlay is open, lets the arch take the spotlight */
    .wp-hub.is-arch-opening .wp-stage,
    .wp-hub.is-arch-opening .wp-info-stack,
    .wp-hub.is-arch-opening .wp-dot-rail {
      opacity: 0;
      pointer-events: none;
      transition: opacity 400ms ease;
    }
    /* Hide the active arch in the carousel during overlay (clone is showing) */
    .wp-arch.is-overlay-source { visibility: hidden; }
  </style>

  <!-- ===== HERO SCRIPT ===== -->
  <script is:inline>
    (() => {
      const VIEW_W = 320;
      const VIEW_H = 400;

      const cfg = {
        amplitude: 5,
        frequency: 2.1,
        speed: 0.017,
        breathAmp: 2.5,
        breathCycle: 5,
        fillRatio: 92,
        spread: 46,
        tilt: 5,
        sideScale: 0.59,
        lightOp: 0.55,
        lightSize: 0.6,
      };

      let phase = 0;
      let activeIdx = 0;
      const startTime = performance.now();

      function buildArchPath(width, height, waveAmp, waveFreq, ph) {
        const topPad = 2;
        const bottomPad = 8;
        const r = width / 2;
        const archY = r + topPad;
        const waveCenter = height - bottomPad;
        const samples = 60;
        let d = `M 0 ${archY} A ${r} ${r} 0 0 1 ${width} ${archY} L ${width} ${waveCenter}`;
        for (let i = 0; i <= samples; i++) {
          const x = width - (i / samples) * width;
          const t = (i / samples) * Math.PI * 2 * waveFreq + ph;
          const y = waveCenter + Math.sin(t) * waveAmp;
          d += ` L ${x.toFixed(2)} ${y.toFixed(2)}`;
        }
        return d + ' Z';
      }

      // Overlay variant: morphs from arch+wave (morph=0) to a full rectangle (morph=1).
      // Top dome and bottom wave both flatten in lockstep with `morph`.
      function buildOverlayPath(width, height, waveAmp, waveFreq, ph, morph) {
        const m = Math.max(0, Math.min(1, morph));
        const topPad = 2 * (1 - m);
        const bottomPad = 8 * (1 - m);
        const r = width / 2;
        const liveAmp = waveAmp * (1 - m);
        const topSamples = 40;
        let d = '';
        for (let i = 0; i <= topSamples; i++) {
          const x = (i / topSamples) * width;
          const dx = x - r;
          const archDipY = (r + topPad) - Math.sqrt(Math.max(0, r * r - dx * dx));
          const y = archDipY * (1 - m);
          d += (i === 0 ? 'M ' : ' L ') + x.toFixed(2) + ' ' + y.toFixed(2);
        }
        const baseY = height - bottomPad;
        d += ` L ${width.toFixed(2)} ${baseY.toFixed(2)}`;
        const bottomSamples = 60;
        for (let i = 0; i <= bottomSamples; i++) {
          const x = width - (i / bottomSamples) * width;
          const t = (i / bottomSamples) * Math.PI * 2 * waveFreq + ph;
          const y = baseY + Math.sin(t) * liveAmp;
          d += ` L ${x.toFixed(2)} ${y.toFixed(2)}`;
        }
        return d + ' Z';
      }

      const paths = [0, 1, 2].map(i => document.getElementById('wpArchPath-' + i));
      const STATIC_PHASE = [0.0, 1.7, 3.4];

      function renderStatic(i) {
        paths[i].setAttribute('d',
          buildArchPath(VIEW_W, VIEW_H, cfg.amplitude, cfg.frequency, STATIC_PHASE[i])
        );
      }
      paths.forEach((_, i) => renderStatic(i));

      const bgCanvas = document.getElementById('wpHubBgCanvas');
      const bgCtx = bgCanvas.getContext('2d');

      function resizeBgCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const w = bgCanvas.offsetWidth;
        const h = bgCanvas.offsetHeight;
        bgCanvas.width = w * dpr;
        bgCanvas.height = h * dpr;
        bgCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function drawBackdrop(progress) {
        const w = bgCanvas.offsetWidth;
        const h = bgCanvas.offsetHeight;
        if (!w || !h) return;

        bgCtx.fillStyle = '#fdfbf7';
        bgCtx.fillRect(0, 0, w, h);

        const radius = Math.max(w, h) * cfg.lightSize;
        const a = cfg.lightOp;

        const l1x = w * (0.22 + progress * 0.56);
        const l1y = h * (0.30 + progress * 0.40);
        const g1 = bgCtx.createRadialGradient(l1x, l1y, 0, l1x, l1y, radius);
        g1.addColorStop(0,    `rgba(255, 252, 244, ${a})`);
        g1.addColorStop(0.45, `rgba(255, 252, 244, ${a * 0.35})`);
        g1.addColorStop(1,    'rgba(255, 252, 244, 0)');
        bgCtx.fillStyle = g1;
        bgCtx.fillRect(0, 0, w, h);

        const l2x = w * (0.78 - progress * 0.56);
        const l2y = h * (0.70 - progress * 0.40);
        const g2 = bgCtx.createRadialGradient(l2x, l2y, 0, l2x, l2y, radius * 0.85);
        g2.addColorStop(0,    `rgba(248, 244, 232, ${a * 0.9})`);
        g2.addColorStop(0.45, `rgba(248, 244, 232, ${a * 0.3})`);
        g2.addColorStop(1,    'rgba(248, 244, 232, 0)');
        bgCtx.fillStyle = g2;
        bgCtx.fillRect(0, 0, w, h);
      }

      const archEls = Array.from(document.querySelectorAll('.wp-arch'));
      const infoEls = Array.from(document.querySelectorAll('.wp-info'));
      const dotEls  = Array.from(document.querySelectorAll('.wp-dot'));
      const wrap    = document.getElementById('wpHubWrap');
      const counter = document.getElementById('wpDotCounter');
      const stage   = document.getElementById('wpStage');

      const ARCH_MAX_WIDTH_RATIO = 0.6;
      const ARCH_ASPECT_W_OVER_H = 0.8;

      function fitArchSize() {
        const stageH = stage.offsetHeight;
        const stageW = stage.offsetWidth;
        if (!stageH || !stageW) return;
        const heightBudget = stageH * (cfg.fillRatio / 100);
        const widthCap = (stageW * ARCH_MAX_WIDTH_RATIO) / ARCH_ASPECT_W_OVER_H;
        const archH = Math.max(240, Math.min(heightBudget, widthCap));
        const archW = archH * ARCH_ASPECT_W_OVER_H;
        archEls.forEach(el => {
          el.style.setProperty('--wp-arch-h', archH + 'px');
          el.style.setProperty('--wp-arch-w', archW + 'px');
        });
      }

      function wrapSlot(s) {
        while (s > 1.5)  s -= 3;
        while (s < -1.5) s += 3;
        return s;
      }

      function setActive(idx) {
        if (idx === activeIdx) return;
        renderStatic(activeIdx);
        activeIdx = idx;
        infoEls.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        dotEls.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        counter.textContent = (idx + 1) + ' / 3';
      }

      function applyCarousel(scrollProgress) {
        const cycle = scrollProgress * 2;
        archEls.forEach((el, i) => {
          const slot = wrapSlot(i - cycle);
          const abs = Math.abs(slot);
          const tx = slot * cfg.spread;
          const ry = slot * -cfg.tilt;
          const sc = abs >= 1 ? cfg.sideScale : 1 - (1 - cfg.sideScale) * abs;
          let op;
          if (abs <= 1) op = 1 - abs * 0.45;
          else          op = Math.max(0, 0.55 - (abs - 1) * 1.1);
          const z = 100 - Math.round(abs * 50);
          el.style.transform =
            `translate(-50%, -50%) translateX(${tx}vw) rotateY(${ry}deg) scale(${sc})`;
          el.style.opacity = op.toFixed(3);
          el.style.zIndex = z;
        });
        const idx = ((Math.round(cycle) % 3) + 3) % 3;
        setActive(idx);
      }

      function tick(now) {
        phase += cfg.speed;
        const elapsed = (now - startTime) / 1000;
        const breathT = (elapsed / cfg.breathCycle) * Math.PI * 2;
        const liveAmp = cfg.amplitude + Math.sin(breathT) * cfg.breathAmp;
        paths[activeIdx].setAttribute('d',
          buildArchPath(VIEW_W, VIEW_H, liveAmp, cfg.frequency, phase)
        );
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      function onScroll() {
        const rect = wrap.getBoundingClientRect();
        const total = wrap.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        const progress = total > 0 ? scrolled / total : 0;
        applyCarousel(progress);
        drawBackdrop(progress);
      }
      function onResize() {
        resizeBgCanvas();
        fitArchSize();
        onScroll();
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
      resizeBgCanvas();
      fitArchSize();
      onScroll();

      function scrollToDoor(i) {
        const total = wrap.offsetHeight - window.innerHeight;
        const target = wrap.offsetTop + total * (i / 2) + 20;
        window.scrollTo({ top: target, behavior: 'smooth' });
      }
      // Arch clicks: active arch opens the room; inactive arches scroll to focus.
      archEls.forEach((el, i) => {
        el.addEventListener('click', () => {
          if (i === activeIdx) openArchAndNavigate();
          else scrollToDoor(i);
        });
      });
      dotEls.forEach((el, i) => el.addEventListener('click', () => scrollToDoor(i)));

      // ─── Arch open animation + cross-page navigation ───
      // OPEN flow:
      //   1. Active arch's photo + clip-path animates from its slot to fullscreen
      //      (700ms, wave amp 5 → 2). Side carousel UI fades out.
      //   2. At fullscreen (arch covers entire viewport), sessionStorage records
      //      which room we're entering. Page navigates to /wellness-portal/<room>.
      //   3. Sub-page loads. Its WellnessSubpageShared script reads the sessionStorage
      //      flag, renders the same overlay arch at fullscreen, then fades it out —
      //      a true cross-page crossfade with the page content underneath.
      // ENTRY (returning from sub-page):
      //   1. Sub-page sets sessionStorage `wpArchExit` with roomIndex + photo URL.
      //   2. Hub loads, reads the flag, scrolls carousel so that room is centered,
      //      renders the overlay arch at fullscreen, then contracts it to slot.
      const overlay        = document.getElementById('wpOverlay');
      const overlayArch    = document.getElementById('wpOverlayArch');
      const overlayImage   = document.getElementById('wpOverlayImage');
      const overlayPath    = document.getElementById('wpOverlayPath');
      const hub            = document.querySelector('.wp-hub');
      const OPEN_DURATION  = 700;
      const ROOM_PATHS = ['/wellness-portal/calm-room', '/wellness-portal/library', '/wellness-portal/wellness-experiences'];
      let isAnimating = false;
      let waveAnimRaf = null;

      function easeInOutCubic(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function animateOverlayShape(startMorph, endMorph, duration) {
        if (waveAnimRaf) cancelAnimationFrame(waveAnimRaf);
        const start = performance.now();
        const staticPhase = 1.2;
        function tick(now) {
          const t = Math.min((now - start) / duration, 1);
          const e = easeInOutCubic(t);
          const morph = startMorph + (endMorph - startMorph) * e;
          overlayPath.setAttribute('d',
            buildOverlayPath(VIEW_W, VIEW_H, cfg.amplitude, cfg.frequency, staticPhase, morph)
          );
          if (t < 1) waveAnimRaf = requestAnimationFrame(tick);
          else waveAnimRaf = null;
        }
        waveAnimRaf = requestAnimationFrame(tick);
      }

      function openArchAndNavigate() {
        if (isAnimating) return;
        isAnimating = true;

        const idx = activeIdx;
        const sourceArch = archEls[idx];
        const sourceImage = sourceArch.querySelector('image');
        const photoUrl = sourceImage.getAttribute('href');
        const rect = sourceArch.getBoundingClientRect();

        overlayImage.setAttribute('href', photoUrl);
        overlayPath.setAttribute('d', paths[idx].getAttribute('d'));
        overlayArch.style.opacity = '1';
        overlayArch.style.top    = rect.top    + 'px';
        overlayArch.style.left   = rect.left   + 'px';
        overlayArch.style.width  = rect.width  + 'px';
        overlayArch.style.height = rect.height + 'px';

        sourceArch.classList.add('is-overlay-source');
        overlay.classList.add('is-open');
        hub.classList.add('is-arch-opening');

        void overlayArch.offsetHeight;
        requestAnimationFrame(() => {
          overlayArch.style.top    = '0px';
          overlayArch.style.left   = '0px';
          overlayArch.style.width  = '100vw';
          overlayArch.style.height = '100vh';
          overlayArch.style.opacity = '0';
          animateOverlayShape(0, 1, OPEN_DURATION);
        });

        // At fullscreen: hand off to sub-page via sessionStorage, then navigate.
        // Sub-page renders the same arch fullscreen on load and fades it out.
        setTimeout(() => {
          sessionStorage.setItem('wpArchEntry', JSON.stringify({
            roomIndex: idx,
            roomImage: photoUrl
          }));
          window.location.href = ROOM_PATHS[idx];
        }, OPEN_DURATION);
      }

      document.querySelectorAll('.wp-info-cta').forEach(a => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openArchAndNavigate();
        });
      });

      // ─── Entry from sub-page: contract arch from fullscreen to slot ───
      // Runs once on page load if sessionStorage flag is set.
      function runEntryFromSubpage() {
        const exitRaw = sessionStorage.getItem('wpArchExit');
        if (!exitRaw) return;
        sessionStorage.removeItem('wpArchExit');
        let data;
        try { data = JSON.parse(exitRaw); } catch (e) { return; }
        if (!data || typeof data.roomIndex !== 'number') return;
        const idx = data.roomIndex;

        // 1. Snap carousel scroll so the target door is centered.
        //    cycle = scrollProgress * 2 = idx → scrollProgress = idx/2
        const total = wrap.offsetHeight - window.innerHeight;
        const targetScroll = wrap.offsetTop + total * (idx / 2);
        window.scrollTo({ top: targetScroll, behavior: 'instant' });
        // Update carousel state to reflect the new scroll
        onScroll();

        const sourceArch = archEls[idx];

        // 2. Render overlay arch at fullscreen covering everything (rectangle, invisible)
        overlayImage.setAttribute('href', data.roomImage);
        overlayPath.setAttribute('d', buildOverlayPath(VIEW_W, VIEW_H, cfg.amplitude, cfg.frequency, 1.2, 1));
        overlayArch.style.opacity = '0';
        overlayArch.style.top    = '0px';
        overlayArch.style.left   = '0px';
        overlayArch.style.width  = '100vw';
        overlayArch.style.height = '100vh';

        sourceArch.classList.add('is-overlay-source');
        overlay.classList.add('is-open');
        hub.classList.add('is-arch-opening');
        isAnimating = true;

        // 3. After one frame for layout to settle, compute source rect and contract
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const rect = sourceArch.getBoundingClientRect();
            overlayArch.style.top    = rect.top    + 'px';
            overlayArch.style.left   = rect.left   + 'px';
            overlayArch.style.width  = rect.width  + 'px';
            overlayArch.style.height = rect.height + 'px';
            overlayArch.style.opacity = '1';
            animateOverlayShape(1, 0, OPEN_DURATION);
            hub.classList.remove('is-arch-opening');

            setTimeout(() => {
              overlay.classList.remove('is-open');
              sourceArch.classList.remove('is-overlay-source');
              isAnimating = false;
            }, OPEN_DURATION + 30);
          });
        });
      }
      runEntryFromSubpage();
    })();
  </script>

</Layout>
