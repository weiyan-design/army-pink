---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Escape Club — Army Pink" description="The Escape Club is Army Pink's community for survivors and supporters — a safe, moderated space for healing, connection, and peer support.">

  <!-- PAGE HERO -->
  <section class="page-hero">
    <span class="pill-label reveal-item">Escape Club</span>
    <h1 class="reveal-item">A community that understands<br>what you've been through.</h1>
    <p class="reveal-item">
      The Escape Club is Army Pink's private community for survivors and supporters.
      Peer support, expert-led wellness sessions, and a space where you never have
      to explain yourself — because everyone here already gets it.
    </p>
    <div class="page-hero-actions reveal-item">
      <a href="#join" class="btn btn-primary">Join the community</a>
      <a href="#tiers" class="btn btn-ghost">See membership options</a>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section" style="background: var(--beige);">
    <div class="container">
      <div class="prose-grid">
        <div class="prose-text">
          <span class="pill-label reveal-item">What is the Escape Club?</span>
          <h2 class="reveal-item">Healing in community.<br>At your own pace.</h2>
          <p class="reveal-item">
            The Escape Club is a private Discord community built specifically for the
            domestic violence survivor experience. No generic wellness advice.
            No toxic positivity. Just real people, at different stages of the journey,
            showing up for each other.
          </p>
          <p class="reveal-item">
            We run weekly expert-led wellness sessions, daily check-in prompts, peer support
            channels, and small-group cohorts — all designed by and for people who have
            lived what you've lived.
          </p>
          <p class="reveal-item">
            <strong>Survivors are always free.</strong> Supporters pay so they don't have to.
          </p>
        </div>
        <div class="prose-image reveal-item">
          <img src="/img/programs-hero.jpg" alt="Community and wellness" />
        </div>
      </div>
    </div>
  </section>

  <!-- MEMBERSHIP TIERS -->
  <section class="section" id="tiers">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-sm);">
        <span class="pill-label reveal-item">Membership</span>
        <h2 class="reveal-item" style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-top: var(--space-sm);">
          Choose your role in the community.
        </h2>
        <p class="reveal-item" style="color: var(--text-light); max-width: 520px; margin: var(--space-sm) auto 0;">
          Survivors and students always join free. Supporters choose a tier that matches
          how they want to show up for the mission.
        </p>
      </div>

      <div class="tier-grid">

        <div class="tier-card reveal-item">
          <div class="tier-who">Survivors &amp; Students</div>
          <div class="tier-price">Free</div>
          <div class="tier-name">Community Member</div>
          <p class="tier-desc">
            Full access to peer support, safety resources, and community channels.
            No payment. No barriers. Always.
          </p>
          <ul class="tier-features">
            <li>Peer support channels</li>
            <li>Daily check-in prompts</li>
            <li>Safety planning resources</li>
            <li>Crisis resources &amp; hotlines</li>
            <li>Introductions &amp; community events</li>
          </ul>
        </div>

        <div class="tier-card reveal-item">
          <div class="tier-who">General Supporters</div>
          <div class="tier-price">$10<small>/mo</small></div>
          <div class="tier-name">Friend</div>
          <p class="tier-desc">
            Support the mission and stay connected with monthly impact updates
            and a visible supporter badge.
          </p>
          <ul class="tier-features">
            <li>Everything in Community Member</li>
            <li>Supporter badge &amp; recognition</li>
            <li>Monthly impact newsletter</li>
            <li>Access to #supporters channel</li>
          </ul>
        </div>

        <div class="tier-card tier-featured reveal-item">
          <div class="tier-badge">Most popular</div>
          <div class="tier-who">Committed Supporters</div>
          <div class="tier-price">$50<small>/mo</small></div>
          <div class="tier-name">Escape Club Member</div>
          <p class="tier-desc">
            Deep engagement with the mission — monthly workshops, small groups,
            and direct connection to Army Pink's work.
          </p>
          <ul class="tier-features">
            <li>Everything in Friend</li>
            <li>Monthly expert-led workshops</li>
            <li>Small group cohorts (10–15 people)</li>
            <li>Quarterly impact reports</li>
            <li>Early access to new programs</li>
          </ul>
        </div>

        <div class="tier-card reveal-item">
          <div class="tier-who">Major Supporters</div>
          <div class="tier-price">$100+<small>/mo</small></div>
          <div class="tier-name">Champion</div>
          <p class="tier-desc">
            Advisory-level engagement — your input shapes Army Pink's direction
            and programming.
          </p>
          <ul class="tier-features">
            <li>Everything in Escape Club Member</li>
            <li>Advisory input on programs</li>
            <li>Named recognition on site &amp; reports</li>
            <li>Quarterly leadership calls</li>
            <li>1-on-1 support coordination access</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- HOW TO JOIN -->
  <section class="section" id="join" style="background: var(--beige);">
    <div class="container" style="max-width: 760px;">
      <div style="text-align: center;">
        <span class="pill-label reveal-item">How It Works</span>
        <h2 class="reveal-item" style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin-top: var(--space-sm);">
          Joining is simple — and safe.
        </h2>
        <p class="reveal-item" style="color: var(--text-light); max-width: 520px; margin: var(--space-sm) auto 0;">
          We use a guided verification process to keep the community safe before
          you see any member discussions.
        </p>
      </div>
      <ol class="steps-list">
        <li class="step reveal-item">
          <span class="step-number">1</span>
          <div class="step-content">
            <h4>Click to join</h4>
            <p>Use the button below to access our Discord server. You'll land in a restricted welcome area — only you and the welcome message can see each other.</p>
          </div>
        </li>
        <li class="step reveal-item">
          <span class="step-number">2</span>
          <div class="step-content">
            <h4>Quick verification</h4>
            <p>React to the community guidelines or complete a brief form. This step screens out bad actors before you see any member conversations. It takes under a minute.</p>
          </div>
        </li>
        <li class="step reveal-item">
          <span class="step-number">3</span>
          <div class="step-content">
            <h4>You're in</h4>
            <p>You'll receive a welcome DM with a tour of key channels, how to get help, and what to expect. Introduce yourself when you're ready — or just listen first. Both are welcome here.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-section">
    <h2 class="reveal-item">You don't have to heal alone.</h2>
    <p class="reveal-item">
      The community is free for survivors. When you're ready, we'll be here.
    </p>
    <div class="cta-actions reveal-item">
      <a href="#" class="btn btn-primary">Join the Escape Club</a>
      <a href="#" class="btn btn-ghost" data-donate-panel>Support as a Friend ($10/mo)</a>
    </div>
  </div>

</Layout>
