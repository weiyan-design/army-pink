---
import Layout from '../layouts/Layout.astro';

// Three impact stats (from Figma). Each label has an orange-highlighted phrase.
// The collage art is a transparent cut-out (PNG) over absolutely-positioned
// SVG blob circles (colours + geometry from the Figma ellipses) — the Figma
// frame export baked its dark canvas into the PNGs, so we rebuild the blobs.
// Blob coords live in a 313×293 viewBox; `cut` positions the cut-out (% of art box).
// NOTE: sources are best-known attributions — Wei to confirm/finalize.
const stats = [
  {
    cutout: '/img/mission/cut-car.png',
    blobs: [
      { cx: 207, cy: 116, r: 91, fill: '#FDD36A', op: 0.5 },
      { cx: 66,  cy: 227, r: 35, fill: '#EA79A9', op: 0.2 },
    ],
    cut: { w: 100, left: 0, top: -2 },
    value: '7',
    pre: '',
    hl: 'average attempts',
    post: ' before a survivor leaves permanently',
    source: 'National Domestic Violence Hotline',
  },
  {
    cutout: '/img/mission/cut-money.png',
    blobs: [
      { cx: 157, cy: 98,  r: 98, fill: '#F3954F', op: 0.5 },
      { cx: 106, cy: 227, r: 35, fill: '#6A7D9A', op: 0.2 },
    ],
    cut: { w: 62, left: 21, top: -2 },
    value: '99%',
    pre: 'domestic violence survivors experience ',
    hl: 'financial abuse',
    post: ' as part of the abuse',
    source: 'National Network to End Domestic Violence',
  },
  {
    cutout: '/img/mission/cut-house.png',
    blobs: [
      { cx: 119, cy: 98,  r: 98, fill: '#B85A73', op: 0.5 },
      { cx: 248, cy: 227, r: 35, fill: '#80657E', op: 0.2 },
    ],
    cut: { w: 84, left: 9, top: 2 },
    value: '80%',
    pre: 'of mothers experiencing ',
    hl: 'homelessness',
    post: ' had previously experienced domestic violence',
    source: 'American Civil Liberties Union',
  },
];

// Pathway to Freedom — the survivor ride journey. Waypoints light up in
// sequence on scroll (driven in script.js). Positions (%) trace the winding
// route from the Figma map; the SVG route uses the same node coordinates.
const pathwaySteps = [
  { label: 'Advocate logs into Lyft Concierge dashboard', x: 42, y: 6,  side: 'right' },
  { label: 'Enter pickup, destination, and survivor name', x: 37, y: 39, side: 'right' },
  { label: 'Ride dispatched to survivor',                  x: 13, y: 66, side: 'right' },
  { label: 'Advocate / Army Pink coordinator monitors ride', x: 49, y: 92, side: 'below' },
  { label: 'Arrival confirmation logged',                  x: 89, y: 80, side: 'right' },
];

// Empowered-by tech partners (reusing the existing colour logo assets).
const empoweredBy = [
  { name: 'Lyft',       img: '/img/partner-logo/color-lyft.png' },
  { name: 'Google',     img: '/img/partner-logo/color-google.svg' },
  { name: 'Microsoft',  img: '/img/partner-logo/color-microsoft.svg' },
  { name: 'monday.com', img: '/img/partner-logo/color-monday.png' },
  { name: 'Salesforce', img: '/img/partner-logo/color-salesforce.svg' },
  { name: 'Slack',      img: '/img/partner-logo/color-slack.svg' },
];
---

<Layout title="Our Mission — Army Pink" description="Army Pink was built by a survivor, for survivors — a movement to remove the practical barriers standing between a survivor and the ability to leave.">

  <!-- ===== PINNED HERO → ORIGIN REVEAL =====
       The founder quote pins as a background (sticky). The cream "built by a
       survivor" origin section flows up over it (higher z-index + solid bg),
       then everything scrolls normally. Pure CSS — sticky is proven on this
       site (see .psg__arch / .ways__pin). ===== -->
  <div class="mv-reveal">
    <section class="mv-hero founder-quote" aria-label="Founder's words">
      <div class="container">
        <figure class="tp-quote">
          <svg class="tp-quote-squiggle" viewBox="0 0 90 80" fill="none" aria-hidden="true">
            <path d="M8 52 C 4 26, 40 14, 52 34 C 60 48, 44 60, 38 46 C 33 34, 52 28, 66 36 C 78 43, 80 22, 70 14" stroke="var(--pink)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="tp-quote-mark" aria-hidden="true">“</span>
          <blockquote class="tp-quote-text">
            What stayed with me most was realizing that survivors are not lacking courage
            <span class="tp-quote-dot" aria-hidden="true"></span>
            — they are lacking the support needed to leave and rebuild their lives.
          </blockquote>
          <figcaption class="tp-quote-chip">
            <img src="/img/people/robin-bement.jpg" alt="Robin Bement" loading="lazy" />
            <span class="tp-quote-chip-meta">
              <span class="tp-quote-chip-name">Robin Bement</span>
              <span class="tp-quote-chip-role">Founder of Army Pink</span>
            </span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="mv-origin">
      <div class="container mv-origin__inner">
        <h2 class="mv-origin__statement reveal-item">Army Pink was built by a survivor,<br>for survivors.</h2>
        <div class="mv-origin__story">
          <figure class="mv-origin__photo reveal-item">
            <!-- PLACEHOLDER: Figma exported a template still here. Swap for a real image. -->
            <img src="/img/mission/founder-story.jpg" alt="" loading="lazy" />
          </figure>
          <div class="mv-origin__text reveal-item">
            <p>Founder Robin Bement knows firsthand that leaving an abusive relationship is rarely as simple as walking away. Even when someone is ready to leave, the obstacles can feel overwhelming—transportation, finances, housing, childcare, isolation, and uncertainty about what comes next.</p>
            <p>When Robin's husband's severe mental health crisis turned violent, she focused on protecting her two young children while trying to find a way forward. She spent nights moving between motels and sleeping in her car with her children, searching for safety and figuring out the next steps.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ===== WHY / THIS MISSION + STATS ===== -->
  <section class="mv-why">
    <div class="container">
      <header class="mv-why__head">
        <div class="mv-why__head-left">
          <h2 class="mv-why__why reveal-item">Why</h2>
          <p class="mv-why__kicker reveal-item">Many survivors are not trapped because they lack courage. They are trapped because they lack support.</p>
        </div>
        <p class="mv-why__mission reveal-item"><em>This Mission</em></p>
      </header>

      <div class="mv-why__body reveal-item">
        <p>During that time, one realization became impossible to ignore:</p>
        <p>Many survivors are not trapped because they lack courage. They are trapped because they lack support. And without support, even the most basic steps forward can feel out of reach.</p>
        <ul class="mv-why__list">
          <li>Transportation becomes harder.</li>
          <li>Housing becomes harder.</li>
          <li>Getting help becomes harder.</li>
          <li>Leaving becomes harder.</li>
        </ul>
        <p>That realization became the foundation for Army Pink. What began as one survivor's experience grew into a movement to remove the practical barriers that can stand between a survivor and the ability to leave.</p>
      </div>

      <ul class="mv-stats">
        {stats.map((s) => (
          <li class="mv-stat reveal-item">
            <div class="mv-stat__art">
              <svg class="mv-stat__blobs" viewBox="0 0 313 293" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                {s.blobs.map((b) => (
                  <circle cx={b.cx} cy={b.cy} r={b.r} fill={b.fill} fill-opacity={b.op} />
                ))}
              </svg>
              <img class="mv-stat__cutout" src={s.cutout} alt="" loading="lazy" style={`width:${s.cut.w}%;left:${s.cut.left}%;top:${s.cut.top}%`} />
            </div>
            <span class="mv-stat__value">{s.value}</span>
            <p class="mv-stat__label">{s.pre}<span class="mv-stat__hl">{s.hl}</span>{s.post}</p>
            <p class="mv-stat__source">Source: {s.source}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== PATHWAY TO FREEDOM ===== -->
  <section class="mv-pathway" data-pathway aria-label="Pathway to Freedom">
    <div class="mv-pathway__top">
      <div class="container">
        <header class="mv-pathway__head reveal-item">
          <h2 class="mv-pathway__title">Pathway to<br>Freedom</h2>
          <div class="mv-pathway__empower">
            <span class="mv-pathway__empower-label">Empowered By</span>
            <!-- Reuses the homepage's second marquee row (reverse-scrolling colour
                 logos): .partner-track--reverse + .partner-tile--static, driven by
                 the global [data-partner-track] marquee in script.js. -->
            <div class="partner-track-wrap mv-pathway__empower-track">
              <div class="partner-track partner-track--reverse" data-partner-track>
                {[0, 1].map((setIdx) => empoweredBy.map((p) => (
                  <div class="partner-tile partner-tile--static" aria-hidden={setIdx === 1 ? 'true' : undefined}>
                    <div class="partner-photo">
                      <img src={p.img} alt={setIdx === 1 ? '' : p.name} loading="lazy" />
                    </div>
                  </div>
                )))}
              </div>
            </div>
          </div>
        </header>
      </div>
    </div>

    <div class="mv-pathway__body">
      <div class="container mv-pathway__grid">
        <!-- Track reserves the left grid column; the figure inside is lifted up
             to top-align with the "Pathway to Freedom" title (overlapping the
             cream band) and pins to viewport centre on scroll — see [data-portrait]
             logic in script.js. Desktop only; mobile falls back to inline flow. -->
        <div class="mv-pathway__portrait-track" data-portrait-track>
          <figure class="mv-pathway__portrait" data-portrait>
            <img src="/img/mission/rides-to-freedom.jpg" alt="A Pathway to Freedom rider" loading="lazy" />
          </figure>
        </div>

        <div class="mv-pathway__main">
          <!-- Winding route map — nodes light up in sequence on scroll -->
          <div class="mv-map" data-map role="img" aria-label="How a Freedom Ride works, step by step">
            <svg class="mv-map__svg" viewBox="0 0 360 380" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
              <path class="mv-map__route" d="M151 23 L120 78 L133 148 L78 205 L47 251 L120 320 L176 350 L258 322 L320 304" />
              <path class="mv-map__route mv-map__route--fill" data-route-fill d="M151 23 L120 78 L133 148 L78 205 L47 251 L120 320 L176 350 L258 322 L320 304" />
            </svg>
            <ol class="mv-map__nodes">
              {pathwaySteps.map((s, i) => (
                <li
                  class={`mv-map__node mv-map__node--${s.side}`}
                  style={`--nx:${s.x}%;--ny:${s.y}%`}
                  data-node={i}
                >
                  <span class="mv-map__dot" aria-hidden="true"></span>
                  <span class="mv-map__label">{s.label}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="mv-pathway__copy reveal-item">
            <p>Army Pink's Pathway to Freedom Movement was created to help survivors reach safety, access shelters, court hearings, counseling appointments, support services, and the basic steps needed to rebuild their lives, while also connecting them with ongoing support through our Wellness Portal.</p>
            <p>Today, Army Pink remains grounded in the belief that survivors deserve more than encouragement. They deserve real support, real options, and the ability to choose their own path forward.</p>
            <p>Every program we build, every partnership we form, and every resource we provide is guided by a simple belief:</p>
          </div>

          <figure class="mv-pathway__quote reveal-item">
            <span class="mv-pathway__quote-mark" aria-hidden="true">“</span>
            <blockquote>No one should be unable to <em>reach safety</em> because the support they need isn't there when they need it.</blockquote>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT WE STAND FOR ===== -->
  <section class="section section-mission" style="background: var(--beige);">
    <div class="container">
      <div class="mv-values__grid">
        <div class="mv-values__intro">
          <span class="pill-label reveal-item">What We Stand For</span>
          <h2 class="mv-values__headline reveal-item">We don't provide rides.<br>We provide access to safety.<br><br>We don't sell healing.<br>We connect you to it.</h2>
        </div>
        <div class="mission-values">
          <div class="value reveal-item">
            <span class="value-number">01</span>
            <div>
              <h4>Safety First</h4>
              <p>Every decision we make — every partnership we form, every resource we share — starts with your safety. Nothing else comes before it.</p>
            </div>
          </div>
          <div class="value reveal-item">
            <span class="value-number">02</span>
            <div>
              <h4>Survivor-Led</h4>
              <p>The people who have lived this journey shape our work. Lived experience isn't a bonus — it's the foundation of everything we build.</p>
            </div>
          </div>
          <div class="value reveal-item">
            <span class="value-number">03</span>
            <div>
              <h4>No Barriers</h4>
              <p>Survivors never pay. Our supporters — individuals, corporations, and grant funders — make free access possible so cost is never the reason someone stays.</p>
            </div>
          </div>
          <div class="value reveal-item">
            <span class="value-number">04</span>
            <div>
              <h4>Choice &amp; Control</h4>
              <p>Every survivor's journey is different. We believe people deserve the freedom to make their own decisions, choose their own path, and define what healing and independence look like for them.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
