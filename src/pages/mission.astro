---
import Layout from '../layouts/Layout.astro';

// Stats section (moved from the home page) — two independent column stacks
// (right one offset down). Reading order pairs across: 1in3/$50, 200/100+,
// Fall 2026/Survivor-led.
const statsCols = [
  [
    { value: '1 in 3', label: 'women experience intimate partner violence (CDC)' },
    { value: '200', label: 'rides in our first LA pilot' },
    { value: 'Fall 2026', label: 'Freedom Rides launch' },
  ],
  [
    { value: '$50', label: 'funds one ride to safety' },
    { value: '100+', label: 'volunteers building the mission' },
    { value: 'Survivor-led', label: "built by people who've lived it" },
  ],
];
---

<Layout title="Our Mission — Army Pink" description="Army Pink is a survivor-led initiative addressing the #1 unmet need for survivors: safe, immediate transportation out of dangerous situations.">

  <!-- PAGE HERO -->
  <section class="page-hero">
    <span class="pill-label reveal-item">Our Mission</span>
    <h1 class="reveal-item">Turning compassion<br>into action.</h1>
    <p class="reveal-item">
      Army Pink is a survivor-led initiative addressing the #1 unmet need for survivors:
      safe, immediate transportation out of dangerous situations. We turn compassion into action
      by providing urgent rides and structured wellness support — helping survivors leave danger
      and begin again with dignity, guidance, and connection.
    </p>
    <div class="page-hero-actions reveal-item">
      <a href="#our-story" class="btn btn-primary">Our story</a>
      <a href="#team" class="btn btn-ghost">Meet the team</a>
    </div>
  </section>

  <!-- IMPACT STATS -->
  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <div class="stat-row">
        <div class="stat-item reveal-item">
          <span class="stat-number">7×</span>
          <span class="stat-label">Average attempts before a survivor leaves permanently</span>
        </div>
        <div class="stat-item reveal-item">
          <span class="stat-number">#1</span>
          <span class="stat-label">Invisible and underfunded barrier to safety: access to safe, reliable transportation</span>
        </div>
        <div class="stat-item reveal-item">
          <span class="stat-number">$0</span>
          <span class="stat-label">Cost to survivors — always free, always will be</span>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="section" id="our-story">
    <div class="container">
      <div class="prose-grid">
        <div class="prose-image reveal-item">
          <img src="/img/empowering-hero.jpg" alt="Yoga and wellness" />
        </div>
        <div class="prose-text">
          <span class="pill-label reveal-item">How We Started</span>
          <h2 class="reveal-item">Built by survivors,<br>for survivors.</h2>
          <p class="reveal-item">
            Army Pink was founded on a simple, painful truth: when survivors finally find the
            courage to leave, they often have nowhere safe to go and no way to get there.
            Shelters are full. Friends are too close to the situation. And calling a rideshare
            from a shared location feels like leaving a trail.
          </p>
          <p class="reveal-item">
            Our <strong>Pathway to Freedom</strong> program fills that gap — providing
            donation-funded Freedom Rides the moment a survivor needs to move. No waiting list.
            No paperwork at the door. Just safe, immediate transportation handled with discretion
            and care.
          </p>
          <p class="reveal-item">
            From there, we stay connected — linking survivors to vetted wellness resources,
            peer community, and structured support for the long road of recovery.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDER QUOTE -->
  <section class="section founder-quote">
    <div class="container">
      <figure class="tp-quote">
        <svg class="tp-quote-squiggle" viewBox="0 0 90 80" fill="none" aria-hidden="true">
          <path d="M8 52 C 4 26, 40 14, 52 34 C 60 48, 44 60, 38 46 C 33 34, 52 28, 66 36 C 78 43, 80 22, 70 14" stroke="var(--pink)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="tp-quote-mark" aria-hidden="true">“</span>
        <blockquote class="tp-quote-text">
          What stayed with me most was realizing that survivors are not lacking courage
          <span class="tp-quote-dot" aria-hidden="true"></span>
          — they are lacking the support needed to leave and rebuild their lives.
        </blockquote>
        <figcaption class="tp-quote-chip">
          <img src="/img/people/robin-bement.jpg" alt="Robin Bement" loading="lazy" />
          <span class="tp-quote-chip-meta">
            <span class="tp-quote-chip-name">Robin Bement</span>
            <span class="tp-quote-chip-role">Founder of Army Pink</span>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section-mission" style="background: var(--beige);">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-lg);">
        <span class="pill-label reveal-item">What We Stand For</span>
        <h2 class="reveal-item" style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-top: var(--space-sm);">
          We don't provide rides.<br>We provide access to safety.<br><br>We don't sell healing.<br>We connect you to it.
        </h2>
      </div>
      <div class="mission-values">
        <div class="value reveal-item">
          <span class="value-number">01</span>
          <div>
            <h4>Safety First</h4>
            <p>Every decision we make — every partnership we form, every resource we share — starts with your safety. Nothing else comes before it.</p>
          </div>
        </div>
        <div class="value reveal-item">
          <span class="value-number">02</span>
          <div>
            <h4>Survivor-Led</h4>
            <p>The people who have lived this journey shape our work. Lived experience isn't a bonus — it's the foundation of everything we build.</p>
          </div>
        </div>
        <div class="value reveal-item">
          <span class="value-number">03</span>
          <div>
            <h4>No Barriers</h4>
            <p>Survivors never pay. Our supporters — individuals, corporations, and grant funders — make free access possible so cost is never the reason someone stays.</p>
          </div>
        </div>
        <div class="value reveal-item">
          <span class="value-number">04</span>
          <div>
            <h4>Choice &amp; Control</h4>
            <p>Every survivor's journey is different. We believe people deserve the freedom to make their own decisions, choose their own path, and define what healing and independence look like for them.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE / STATS (moved from home) ===== -->
  <section class="stats-section" aria-label="Army Pink at a glance">
    <div class="stats-grid">
      <div class="stats-text">
        <p>
          Army Pink is a survivor-led nonprofit providing safe, discreet
          transportation for people escaping domestic violence. Working
          alongside crisis organizations and referral partners, our
          volunteer-powered team is building Freedom Rides — launching
          Fall 2026 with a 200-ride pilot in Los Angeles.
        </p>
      </div>
      <div class="stats-cells">
        {statsCols.map((col, ci) => (
          <div class={`stats-col${ci === 1 ? ' stats-col--offset' : ''}`}>
            {col.map((s) => (
              <div class="stat-cell reveal-item">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== OUR MISSION (moved from home) ===== -->
  <section class="section section-mission" id="mission">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-text">
          <span class="pill-label reveal-item">Our Mission</span>
          <h2 class="section-title reveal-item">We don't provide rides.<br>We provide access to safety.<br><br>We don't sell healing.<br>We connect you to it.</h2>
          <p class="section-text reveal-item">
            Army Pink is a 501(c)(3) nonprofit supporting domestic violence survivors
            through safety-centered transportation, concierge support, and wellness resources.
          </p>
          <p class="section-text reveal-item">
            Our <strong>Pathway to Freedom</strong> program provides donation-based Freedom Rides —
            immediate safe transportation when you need it most — plus connections to
            ongoing wellness support for the road ahead.
          </p>
          <p class="quiet">Based in California. Serving survivors nationwide.</p>
        </div>
        <div class="mission-values">
          <div class="value">
            <span class="value-number">01</span>
            <div>
              <h4>Safety First</h4>
              <p>Every decision we make starts with your safety.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">02</span>
            <div>
              <h4>Survivor-Led</h4>
              <p>People who understand the journey shape our work.</p>
            </div>
          </div>
          <div class="value">
            <span class="value-number">03</span>
            <div>
              <h4>No Barriers</h4>
              <p>Survivors never pay. Supporters make that possible.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section" id="team">
    <div class="container">
      <div style="text-align: center;">
        <span class="pill-label reveal-item">The People Behind Army Pink</span>
        <h2 class="reveal-item" style="font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); margin-top: var(--space-sm);">
          Meet our team.
        </h2>
        <p class="reveal-item" style="color: var(--text-light); max-width: 520px; margin: var(--space-sm) auto var(--space-md);">
          A growing group of survivors, advocates, designers, engineers, and wellness
          professionals united by a single purpose.
        </p>
        <a href="/team" class="btn btn-primary reveal-item">Meet the full team</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-section">
    <h2 class="reveal-item">Ready to help us grow?</h2>
    <p class="reveal-item">
      Every donation funds a Freedom Ride. Every supporter gives a survivor one more option.
    </p>
    <div class="cta-actions reveal-item">
      <a href="#" class="btn btn-primary" data-donate-panel>Donate now</a>
      <a href="/donate" class="btn btn-ghost">Join the community</a>
    </div>
  </div>

</Layout>
