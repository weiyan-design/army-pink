---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Get Involved — Army Pink" description="Be the reason someone gets out. Four ways to help Army Pink: fund a ride, partner with purpose, give your time, or rally your community.">

  <!-- HERO — rounded video banner, then headline (left) + subtext / Give Now
       (right) on cream. The "safe exit" clip plays as an ambient loop. -->
  <section class="gih" aria-label="Be the reason someone gets out">
    <div class="gih__inner">
      <div class="gih__media">
        <video
          class="gih__vid"
          src="/vid/safe-exit-hero.mp4"
          poster="/img/donate/hero-poster.jpg"
          autoplay muted loop playsinline preload="auto"
          aria-label="Safe exit is a right."
        ></video>
      </div>
      <div class="gih__row">
        <h1 class="gih__title">Be the reason someone <span class="gih__accent">gets out</span></h1>
        <div class="gih__aside">
          <p class="gih__lead">Give, partner, volunteer, or rally your community — here's how you help survivors reach safety.</p>
          <button class="btn btn-primary gih__cta" type="button" data-donate-panel>Give Now</button>
        </div>
      </div>
    </div>
  </section>

  <!-- WAYS TO GIVE — Figma "WorksWrap": left copy scrolls; the right panel is
       pinned (sticky) and crossfades a visual per active step. Dark-green band. -->
  <section class="giw" id="ways" aria-label="Ways to give" data-giw>
    <div class="giw__grid">
      <!-- LEFT: scrolling copy -->
      <div class="giw__left">
        <article class="giw__step" data-step="0">
          <div class="giw__copy">
            <h2 class="giw__title">Fund the <span class="giw__accent" style="color:#ea79a9">first 200 rides</span> and help launch the movement.</h2>
            <p class="giw__body">Every gift helps provide safe, discreet transportation for survivors who need to leave unsafe environments, reach safe destinations, or access critical services.</p>
          </div>
        </article>
        <article class="giw__step" data-step="1">
          <div class="giw__copy">
            <h2 class="giw__title"><span class="giw__accent" style="color:#f4c84e">Give monthly</span> and keep safe rides available for survivors year-round.</h2>
            <p class="giw__body">Through recurring monthly gifts, <strong>Escape Club members</strong> help sustain Freedom Rides and provide the reliable funding needed to keep transportation available when survivors need to leave.</p>
          </div>
        </article>
        <article class="giw__step" data-step="2">
          <div class="giw__copy">
            <h2 class="giw__title">Start your own fundraiser and <span class="giw__accent" style="color:#e8833a">rally your people</span> to help.</h2>
            <p class="giw__body">Start your own fundraiser and rally your community — because this is about proving what's possible when people come together to remove barriers and create access to safety.</p>
          </div>
        </article>
        <article class="giw__step" data-step="3">
          <div class="giw__copy">
            <h2 class="giw__title">Bring your <span class="giw__accent" style="color:#8b7fd4">organization's</span> funding or services to keep survivors moving.</h2>
            <p class="giw__body">Partner with Army Pink through funding, services, or sponsorship to help strengthen the network of organizations, advocates, and support systems that move survivors toward safety.</p>
          </div>
        </article>
        <article class="giw__step" data-step="4">
          <div class="giw__copy">
            <h2 class="giw__title">Give goods, services, or <span class="giw__accent" style="color:#5bb3a0">auction items</span> that help survivors further.</h2>
            <p class="giw__body">In-kind support that helps Army Pink stretch every dollar and keep safe transportation available for more survivors.</p>
          </div>
        </article>
        <article class="giw__step" data-step="5">
          <div class="giw__copy">
            <h2 class="giw__title">Start a <span class="giw__accent" style="color:#ea79a9">campus chapter</span> and raise funds and awareness together</h2>
            <p class="giw__body">Through campus chapters, student-led events, and awareness campaigns, Campus Impact connects young leaders with Army Pink's mission to help remove barriers survivors face when seeking safety.</p>
          </div>
        </article>
        <article class="giw__step" data-step="6">
          <div class="giw__copy">
            <h2 class="giw__title">Join our auction, <span class="giw__accent" style="color:#f4c84e">bid on experiences</span>, and fund more rides.</h2>
            <p class="giw__body">Join our benefit auction to bid on standout experiences and items, turning a night out into rides that move survivors toward safety.</p>
          </div>
        </article>
      </div>
      <!-- RIGHT: pinned panel whose visual crossfades -->
      <div class="giw__right">
        <div class="giw__card">
          <div class="giw__viz is-active" data-art="0">
            <video class="giw__vid giw__vid--portrait" src="/vid/impact-loop-200rides.mp4" autoplay muted loop playsinline preload="auto"></video>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="1">
            <img class="giw__vid giw__vid--logo" src="/vid/escape-club-logo.gif" alt="Escape Club logo" />
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="2">
            <div class="giw__ph"><b>03</b><span>Right-side placeholder</span></div>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="3">
            <div class="giw__ph"><b>04</b><span>Right-side placeholder</span></div>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="4">
            <div class="giw__ph"><b>05</b><span>Right-side placeholder</span></div>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="5">
            <div class="giw__ph"><b>06</b><span>Right-side placeholder</span></div>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
          <div class="giw__viz" data-art="6">
            <div class="giw__ph"><b>07</b><span>Right-side placeholder</span></div>
            <button class="giw__btn" type="button" data-donate-panel>Give Now</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var section = document.querySelector('[data-giw]');
      var steps = document.querySelectorAll('.giw__step');
      var vizes = document.querySelectorAll('.giw__viz');
      if (!section || !steps.length || !vizes.length) return;

      function setActive(i) {
        for (var j = 0; j < vizes.length; j++) vizes[j].classList.toggle('is-active', j === i);
      }
      if (!('IntersectionObserver' in window)) { setActive(0); return; }

      // Crossfade the right panel to whichever step is centred.
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) setActive(parseInt(e.target.getAttribute('data-step'), 10));
        });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      steps.forEach(function (s) { io.observe(s); });

      // The panel is fixed, so only reveal it while the section actually FILLS
      // the viewport (its top is past the header AND its bottom is below the
      // viewport). That keeps it from overlapping the hero above or footer below
      // as you scroll in/out.
      var headerEl = document.querySelector('.site-header');
      function updatePin() {
        var top = headerEl ? headerEl.getBoundingClientRect().bottom : 120;
        var rect = section.getBoundingClientRect();
        section.classList.toggle('is-onscreen', rect.top <= top && rect.bottom >= window.innerHeight);
      }
      var pinTick = false;
      function onPinScroll() {
        if (pinTick) return;
        pinTick = true;
        requestAnimationFrame(function () { updatePin(); pinTick = false; });
      }
      window.addEventListener('scroll', onPinScroll, { passive: true });
      window.addEventListener('resize', onPinScroll);
      updatePin();
    })();
  </script>

</Layout>
