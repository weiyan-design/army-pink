---
/*
 * ARCHIVED 2026-06-24 — "Healing is harder alone." community teaser carousel.
 * Removed from src/pages/index.astro (was the feature-carousel between the donate
 * form and the partners marquee). Kept here for future reuse. Files under
 * src/_archive/ are NOT built by Astro.
 */
---

<!-- ===== ESCAPE CLUB TEASER ===== -->
<section class="feature-carousel feature-carousel--cream" data-feature-carousel>
  <svg class="fc-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,36 C360,0 720,76 1080,36 C1260,16 1380,46 1440,36 L1440,80 L0,80 Z"/>
  </svg>
  <div class="container">
    <div class="fc-header">
      <h2>Healing is harder alone.</h2>
      <a href="/donate" class="btn btn-ghost">Join the community</a>
    </div>
    <div class="fc-track">
      <article class="fc-card is-active" data-caption="A community of survivors who've walked your path — meeting you in the in-between.">
        <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
      </article>
      <article class="fc-card" data-caption="Weekly check-ins, kept small enough to feel personal.">
        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
      </article>
      <article class="fc-card" data-caption="Mentors who remember what year one felt like.">
        <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
      </article>
      <article class="fc-card" data-caption="Cohorts that move at your pace — no one is left behind.">
        <img src="https://images.unsplash.com/photo-1543269865-cbf427effbad?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
      </article>
      <article class="fc-card" data-caption="Peer support designed for the long stretch after the escape.">
        <img src="https://images.unsplash.com/photo-1502635385003-ee1e6a1a742d?w=600&h=1000&fit=crop&q=80" alt="" loading="lazy" />
      </article>
    </div>
    <div class="fc-footer">
      <p class="fc-caption">A community of survivors who've walked your path — meeting you in the in-between.</p>
      <div class="fc-controls">
        <button class="fc-arrow fc-arrow--prev" aria-label="Previous">&lsaquo;</button>
        <button class="fc-arrow fc-arrow--next" aria-label="Next">&rsaquo;</button>
      </div>
    </div>
  </div>
</section>
