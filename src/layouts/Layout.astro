---
interface Props {
  title?: string;
  description?: string;
  /** Initial nav variant before JS adaptivity kicks in (avoids a flash on pages
   *  whose first section sits behind the nav). 'transparent' | 'light' | 'dark'. */
  navStart?: 'transparent' | 'light' | 'dark';
}

const {
  title = 'Army Pink — Pathway to Freedom',
  description = 'Army Pink is a survivor-led initiative addressing the #1 unmet need for survivors: safe, immediate transportation out of dangerous situations. We turn compassion into action by providing urgent rides and structured wellness support, helping survivors of domestic abuse leave danger and begin again with dignity, guidance, and connection.',
  navStart,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/mission', label: 'Mission' },
  { href: '/wellness-portal', label: 'Calm Room' },
  { href: '/get-involved', label: 'Get Involved', children: [
    { href: '/donate', label: 'Donate' },
    { href: '/partners', label: 'Partner' },
    { href: '/volunteers', label: 'Volunteer' },
    { href: '/community', label: 'Activate your community' },
  ] },
  { href: '/team', label: 'Leadership' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navInitial = navStart ? `is-${navStart}` : (path === '/' ? 'is-transparent' : 'is-light');
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  <script async src="https://widgets.givebutter.com/latest.umd.cjs?acct=yLfulzFp7eIMG8jn" is:inline></script>
</head>
<body class={path === '/' ? 'has-sky-hero' : undefined}>

  <!-- ===== STICKY HEADER (crisis banner + nav, always visible) ===== -->
  <header class="site-header">
    <!-- ===== CRISIS BANNER ===== -->
    <div class="crisis-banner" role="complementary" aria-label="Crisis resources">
      <p>
        If you are in immediate danger, call <strong>911</strong>. &nbsp;
        National DV Hotline: <a href="tel:18007997233"><strong>1-800-799-7233</strong></a> &nbsp;|&nbsp;
        Text <strong>START</strong> to <strong>88788</strong> &nbsp;|&nbsp;
        <a href="https://www.thehotline.org" target="_blank" rel="noopener">thehotline.org</a> &nbsp;|&nbsp;
        Remember to <strong>clear your browser history</strong> when finished.
      </p>
    </div>

    <!-- ===== NAVIGATION (floating glassy pill; JS swaps light/dark/transparent) ===== -->
    <nav class={`main-nav ${navInitial}`} aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="logo" aria-label="Army Pink home">
          <img src="/img/AP_Logo.png" alt="Army Pink" class="logo-img" />
        </a>
        <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-links">
          {navLinks.map(link => (
            <li class={link.children ? 'has-dropdown' : undefined}>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} aria-haspopup={link.children ? 'true' : undefined}>{link.label}</a>
              {link.children && (
                <ul class="nav-dropdown">
                  {link.children.map(child => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a href="#" class="btn btn-primary nav-donate" data-donate-panel>Donate</a>
      </div>
    </nav>
  </header>

  <!-- ===== SAFE EXIT ===== -->
  <div class="safe-exit-wrap" role="complementary" aria-label="Safe exit">
    <span class="safe-exit-tooltip" aria-hidden="true">Press ESC to exit</span>
    <button class="safe-exit-btn" id="safeExitBtn" aria-label="Immediately leave this site">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      <span>Quick Exit</span>
    </button>
  </div>

  <!-- ===== SHARED "BECOME A VOLUNTEER" SLIDE-UP FORM (any [data-volunteer-form] opens it) ===== -->
  <div class="vform" data-volunteer-overlay hidden>
    <div class="vform__backdrop" data-vform-close></div>
    <div class="vform__sheet" role="dialog" aria-modal="true" aria-labelledby="vform-title">
      <button class="vform__close" type="button" data-vform-close aria-label="Close">&times;</button>
      <h2 class="vform__title" id="vform-title">Become a volunteer</h2>
      <p class="vform__intro">Tell us a little about you and how you'd like to help — we'll be in touch.</p>
      <form class="vform__form" name="volunteer" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-vform-form>
        <input type="hidden" name="form-name" value="volunteer" />
        <p class="vform__hp" hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <label class="vform__field"><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
        <label class="vform__field"><span>Email</span><input type="email" name="email" autocomplete="email" required /></label>
        <label class="vform__field"><span>Your message</span><textarea name="message" rows="4" required></textarea></label>
        <button class="btn btn-primary vform__submit" type="submit">Send</button>
        <p class="vform__status" data-vform-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- ===== SHARED CONTACT SLIDE-UP FORM (any [data-contact-form] opens it) — routed
       to support@armypink via Netlify (set the form's notification recipient in the
       Netlify dashboard, like the /contact form) ===== -->
  <div class="vform" data-contact-overlay hidden>
    <div class="vform__backdrop" data-cform-close></div>
    <div class="vform__sheet" role="dialog" aria-modal="true" aria-labelledby="cform-title">
      <button class="vform__close" type="button" data-cform-close aria-label="Close">&times;</button>
      <h2 class="vform__title" id="cform-title">Get in touch</h2>
      <p class="vform__intro">Tell us how you'd like to help — a partnership, an event, or a campus chapter — and we'll be in touch.</p>
      <form class="vform__form" name="get-involved" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-cform-form>
        <input type="hidden" name="form-name" value="get-involved" />
        <p class="vform__hp" hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <label class="vform__field"><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
        <label class="vform__field"><span>Email</span><input type="email" name="email" autocomplete="email" required /></label>
        <label class="vform__field"><span>How can we help?</span><textarea name="message" rows="4" required></textarea></label>
        <button class="btn btn-primary vform__submit" type="submit">Send</button>
        <p class="vform__status" data-cform-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- ===== FOOTER ===== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-brand">
          <div class="footer-logo-wrap">
            <img src="/img/AP_Logo.png" alt="Army Pink" class="logo-img" />
          </div>
          <p>Supporting domestic violence survivors through safety, transportation, and wellness.</p>
          <div class="footer-social">
            <a href="https://www.instagram.com/armypink" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.pinterest.com/armypink/" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <a href="https://www.youtube.com/@armypink" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/army-pink/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-links">
          <h4>Resources</h4>
          <ul>
            <li><a href="tel:18007997233">DV Hotline: 1-800-799-7233</a></li>
            <li><a href="https://www.thehotline.org" target="_blank" rel="noopener">thehotline.org</a></li>
            <li><a href="#">Safety Planning</a></li>
            <li><a href="#">Crisis Text Line: Text START to 88788</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>About</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/mission">Mission</a></li>
            <li><a href="/get-involved">Get Involved</a></li>
            <li><a href="/wellness-portal">Calm Room</a></li>
            <li><a href="/partners">Partners</a></li>
            <li><a href="/team">Leadership</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>Connect</h4>
          <ul>
            <li><a href="/volunteers">Volunteer</a></li>
            <li><a href="#">Perks</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact Us</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/sms-terms">SMS Terms &amp; Conditions</a></li>
            <li><a href="/disclaimer">Disclaimer</a></li>
          </ul>
        </div>

      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Army Pink. All rights reserved. 501(c)(3) nonprofit.</p>
      </div>
    </div>
  </footer>

  <!-- Hidden Givebutter trigger — clicked programmatically by [data-donate-panel] handlers.
       Archived slide-up panel design at src/_archive/donate-panel.md -->
  <div class="givebutter-trigger-wrap" aria-hidden="true">
    <givebutter-button id="gb-trigger" campaign="GHP0EF"></givebutter-button>
  </div>

  <!-- Lenis smooth scroll (drives the curtain + char-reveal feel) -->
  <script type="module" is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const { default: Lenis } = await import('https://esm.sh/lenis@1.1.13');
      const lenis = new Lenis({
        lerp: 0.1,
        smoothWheel: true,
        smoothTouch: false,
      });
      function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
      window.lenis = lenis;
    }
  </script>

  <script src="/script.js" is:inline></script>
  <script is:inline>lucide.createIcons();</script>

</body>
</html>
