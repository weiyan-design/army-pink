---
import { languages, defaultLang } from '../i18n/config.js';
import { useTranslations, getLangFromLocale, localizedPath, stripLocale } from '../i18n/utils.js';

interface Props {
  title?: string;
  description?: string;
  /** Initial nav variant before JS adaptivity kicks in (avoids a flash on pages
   *  whose first section sits behind the nav). 'transparent' | 'light' | 'dark'. */
  navStart?: 'transparent' | 'light' | 'dark';
}

// Locale is inferred from the route the page lives under (/es/* → 'es'), so pages
// don't have to thread `lang` into the Layout. `t()` looks up shell copy and falls
// back to English for any key Spanish hasn't translated yet.
const lang = getLangFromLocale(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  navStart,
} = Astro.props;

const navLinks = [
  { href: '/', label: t('nav.home') },
  { href: '/mission', label: t('nav.mission') },
  { href: '/wellness-portal', label: t('nav.calmRoom') },
  { href: '/get-involved', label: t('nav.getInvolved') },
  { href: '/team', label: t('nav.leadership') },
  { href: '/volunteers', label: t('nav.volunteers') },
];
// Archived 2026-06-26 — the "Get Involved" dropdown menu (may be restored).
// To bring it back, add this `children` array onto the Get Involved item above:
//   children: [
//     { href: '/donate', label: 'Donate' },
//     { href: '/partners', label: 'Partner' },
//     { href: '/volunteers', label: 'Volunteer' },
//     { href: '/community', label: 'Activate your community' },
//   ]

// `logicalPath` is the route with any locale prefix removed — it drives home
// detection, active-link state, and the language switcher (so ES links point at
// the Spanish twin of the current page, not always back to /es/).
const logicalPath = stripLocale(Astro.url.pathname);
const isHome = logicalPath === '/';
const navInitial = navStart ? `is-${navStart}` : (isHome ? 'is-transparent' : 'is-light');
function isActive(href: string) {
  if (href === '/') return logicalPath === '/';
  return logicalPath === href || logicalPath.startsWith(href + '/');
}
const localeCodes = Object.keys(languages);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {/* hreflang alternates — tells search engines about the language twins.
      Resolved against the current origin; set `site` in astro.config.mjs once
      the production domain is final for canonical absolute URLs. */}
  {localeCodes.map((code) => (
    <link rel="alternate" hreflang={code} href={new URL(localizedPath(logicalPath, code), Astro.url).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(logicalPath, defaultLang), Astro.url).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  <script async src="https://widgets.givebutter.com/latest.umd.cjs?acct=yLfulzFp7eIMG8jn" is:inline></script>
</head>
<body class={isHome ? 'has-sky-hero' : undefined}>

  <!-- ===== STICKY HEADER (crisis banner + nav, always visible) ===== -->
  <header class="site-header">
    <!-- ===== CRISIS BANNER ===== -->
    <div class="crisis-banner" role="complementary" aria-label={t('crisis.aria')}>
      <p set:html={t('crisis.line')}></p>
    </div>

    <!-- ===== NAVIGATION (floating glassy pill; JS swaps light/dark/transparent) ===== -->
    <nav class={`main-nav ${navInitial}`} aria-label={t('nav.ariaMain')}>
      <div class="nav-inner">
        <a href={localizedPath('/', lang)} class="logo" aria-label={t('nav.logoAria')}>
          <img src="/img/AP_Logo.png" alt="Army Pink" class="logo-img" />
        </a>
        <button class="mobile-menu-toggle" aria-label={t('nav.ariaToggle')} aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-links">
          {navLinks.map(link => (
            <li class={link.children ? 'has-dropdown' : undefined}>
              <a href={localizedPath(link.href, lang)} aria-current={isActive(link.href) ? 'page' : undefined} aria-haspopup={link.children ? 'true' : undefined}>{link.label}</a>
              {link.children && (
                <ul class="nav-dropdown">
                  {link.children.map(child => (
                    <li><a href={localizedPath(child.href, lang)}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <div class="nav-lang" role="group" aria-label={t('nav.langAria')}>
          {localeCodes.map((code) => (
            <a href={localizedPath(logicalPath, code)} lang={code} hreflang={code} class={code === lang ? 'is-current' : undefined} aria-current={code === lang ? 'true' : undefined}>{code.toUpperCase()}</a>
          ))}
        </div>
        <a href="#" class="btn btn-primary nav-donate" data-donate-panel>{t('nav.donate')}</a>
      </div>
    </nav>
  </header>

  <!-- ===== SAFE EXIT ===== -->
  <div class="safe-exit-wrap" role="complementary" aria-label={t('safeExit.groupAria')}>
    <span class="safe-exit-tooltip" aria-hidden="true">{t('safeExit.tooltip')}</span>
    <button class="safe-exit-btn" id="safeExitBtn" aria-label={t('safeExit.aria')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      <span>{t('safeExit.label')}</span>
    </button>
  </div>

  <!-- ===== SHARED "BECOME A VOLUNTEER" SLIDE-UP FORM (any [data-volunteer-form] opens it) ===== -->
  <div class="vform" data-volunteer-overlay hidden>
    <div class="vform__backdrop" data-vform-close></div>
    <div class="vform__sheet" role="dialog" aria-modal="true" aria-labelledby="vform-title">
      <button class="vform__close" type="button" data-vform-close aria-label={t('form.close')}>&times;</button>
      <h2 class="vform__title" id="vform-title">{t('vform.volTitle')}</h2>
      <p class="vform__intro">{t('vform.volIntro')}</p>
      <form class="vform__form" name="volunteer" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-vform-form>
        <input type="hidden" name="form-name" value="volunteer" />
        <p class="vform__hp" hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <label class="vform__field"><span>{t('form.name')}</span><input type="text" name="name" autocomplete="name" required /></label>
        <label class="vform__field"><span>{t('form.email')}</span><input type="email" name="email" autocomplete="email" required /></label>
        <label class="vform__field"><span>{t('vform.volMessage')}</span><textarea name="message" rows="4" required></textarea></label>
        <button class="btn btn-primary vform__submit" type="submit">{t('form.send')}</button>
        <p class="vform__status" data-vform-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- ===== SHARED CONTACT SLIDE-UP FORM (any [data-contact-form] opens it) — routed
       to support@armypink via Netlify (set the form's notification recipient in the
       Netlify dashboard, like the /contact form) ===== -->
  <div class="vform" data-contact-overlay hidden>
    <div class="vform__backdrop" data-cform-close></div>
    <div class="vform__sheet" role="dialog" aria-modal="true" aria-labelledby="cform-title">
      <button class="vform__close" type="button" data-cform-close aria-label={t('form.close')}>&times;</button>
      <h2 class="vform__title" id="cform-title">{t('vform.contactTitle')}</h2>
      <p class="vform__intro">{t('vform.contactIntro')}</p>
      <form class="vform__form" name="get-involved" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-cform-form>
        <input type="hidden" name="form-name" value="get-involved" />
        <p class="vform__hp" hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <label class="vform__field"><span>{t('form.name')}</span><input type="text" name="name" autocomplete="name" required /></label>
        <label class="vform__field"><span>{t('form.email')}</span><input type="email" name="email" autocomplete="email" required /></label>
        <label class="vform__field"><span>{t('vform.contactMessage')}</span><textarea name="message" rows="4" required></textarea></label>
        <button class="btn btn-primary vform__submit" type="submit">{t('form.send')}</button>
        <p class="vform__status" data-cform-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- ===== FOOTER ===== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-brand">
          <div class="footer-logo-wrap">
            <img src="/img/AP_Logo.png" alt="Army Pink" class="logo-img" />
          </div>
          <p>{t('footer.brand')}</p>
          <p class="footer-locale">{t('footer.locale')}</p>
          <div class="footer-social">
            <a href="https://www.instagram.com/armypink" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.pinterest.com/armypink/" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
            <a href="https://www.youtube.com/@armypink" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/army-pink/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-links">
          <h4>{t('footer.resources')}</h4>
          <ul>
            <li><a href="tel:18007997233">{t('footer.hotline')}</a></li>
            <li><a href="https://www.thehotline.org" target="_blank" rel="noopener">thehotline.org</a></li>
            <li><a href="#">{t('footer.safetyPlanning')}</a></li>
            <li><a href="#">{t('footer.crisisText')}</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>{t('footer.about')}</h4>
          <ul>
            <li><a href={localizedPath('/', lang)}>{t('nav.home')}</a></li>
            <li><a href={localizedPath('/mission', lang)}>{t('nav.mission')}</a></li>
            <li><a href={localizedPath('/get-involved', lang)}>{t('nav.getInvolved')}</a></li>
            <li><a href={localizedPath('/wellness-portal', lang)}>{t('nav.calmRoom')}</a></li>
            <li><a href={localizedPath('/partners', lang)}>{t('footer.partners')}</a></li>
            <li><a href={localizedPath('/team', lang)}>{t('nav.leadership')}</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>{t('footer.connect')}</h4>
          <ul>
            <li><a href={localizedPath('/volunteers', lang)}>{t('footer.volunteer')}</a></li>
            <li><a href="#">{t('footer.perks')}</a></li>
            <li><a href={localizedPath('/faq', lang)}>{t('footer.faq')}</a></li>
            <li><a href={localizedPath('/contact', lang)}>{t('footer.contact')}</a></li>
          </ul>
        </div>

        <div class="footer-links">
          <h4>{t('footer.legal')}</h4>
          <ul>
            <li><a href={localizedPath('/privacy', lang)}>{t('footer.privacy')}</a></li>
            <li><a href={localizedPath('/sms-terms', lang)}>{t('footer.smsTerms')}</a></li>
            <li><a href={localizedPath('/disclaimer', lang)}>{t('footer.disclaimer')}</a></li>
          </ul>
          <a class="footer-badge" href="https://app.candid.org/profile/16567005/army-pink" target="_blank" rel="noopener" aria-label="Candid Silver Transparency 2026 — view Army Pink's profile">
            <img src="/img/candid-silver-transparency-2026.png" alt="Candid Silver Transparency 2026 Seal" loading="lazy" />
          </a>
        </div>

      </div>
      <div class="footer-bottom">
        <p>{t('footer.copyright')}</p>
      </div>
    </div>
  </footer>

  <!-- Hidden Givebutter trigger — clicked programmatically by [data-donate-panel] handlers.
       Archived slide-up panel design at src/_archive/donate-panel.md -->
  <div class="givebutter-trigger-wrap" aria-hidden="true">
    <givebutter-button id="gb-trigger" campaign="GHP0EF"></givebutter-button>
  </div>

  <!-- Lenis smooth scroll (drives the curtain + char-reveal feel) -->
  <script type="module" is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const { default: Lenis } = await import('https://esm.sh/lenis@1.1.13');
      const lenis = new Lenis({
        lerp: 0.1,
        smoothWheel: true,
        smoothTouch: false,
      });
      function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
      window.lenis = lenis;
    }
  </script>

  <script src="/script.js" is:inline></script>
  <script is:inline>lucide.createIcons();</script>

</body>
</html>
